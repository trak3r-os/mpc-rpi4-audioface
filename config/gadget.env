# rpi-audio gadget settings, installed as /etc/rpi-audio/gadget.env.
# What each value means: gadget/rpi-audio-gadget. Host-specific requirements
# (e.g. the Akai Force: 44100 only) are in docs/hosts/.
# F1 goes 2 -> 16 -> 24 -> 26 channels; the fallback matrix is in docs/PLAN.md (F1).
# Changing a value: tools/deploy.sh, then `sudo systemctl restart rpi-audio-gadget`
# (one rebind, never in a loop).
GADGET_CHANNELS=26
GADGET_SRATE=44100
GADGET_SSIZE=2
GADGET_HS_BINT=2
GADGET_REQ_NUMBER=4
GADGET_C_SYNC=async
GADGET_PRODUCT=rpi-audio
GADGET_MANUFACTURER=rpi-audio
# USB MIDI next to the audio (docs/MIDI.md): cable 1 carries rpi-audiod's control
# map, the others the MIDI of the devices plugged into the Pi. 0 = no MIDI.
GADGET_MIDI_PORTS=4
GADGET_MIDI_ID=MIDIGadget
# What rpi-audio-keepalive plays into the gadget while the host streams:
# silence, or tones (channel k = k x 110 Hz) for the F1 tests with tonecheck.
KEEPALIVE_SOURCE=silence
