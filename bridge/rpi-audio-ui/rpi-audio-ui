#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-or-later
"""rpi-audio-ui: the small display (a 128x64 SH1106 OLED on I2C) with a rotary encoder and three buttons, as one more
client of rpi-audiod (docs/DISPLAY.md). It shows /run/rpi-audio/status.json and answers with the commands of
docs/MIDI.md, run through `rpi-audiod cmd`. The audio never depends on it: with no display or no GPIO it waits and
tries again, and rpi-audiod is untouched either way.

  rpi-audio-ui [run]     the service (rpi-audio-ui.service)

Settings: the [ui] table of /etc/rpi-audio/rpi-audio.toml and rpi-audio.d/*.toml (config/rpi-audio.toml), then what
the Settings screen changed, kept in settings.json in the service's state directory (it wins over the file)."""

import argparse
import json
import os
import signal
import subprocess
import sys
import time
import tomllib
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

import inputs
import meters
import sh1106
import telemetry
import uiservice

CONFIG = Path(os.environ.get("RPI_AUDIO_CONFIG", "/etc/rpi-audio/rpi-audio.toml"))
STATUS = Path(os.environ.get("RUNTIME_DIRECTORY", "/run/rpi-audio")) / "status.json"
AUDIOD = os.environ.get("RPI_AUDIOD", "/usr/local/lib/rpi-audio/rpi-audiod")
SAVED = (Path(os.environ["STATE_DIRECTORY"].split(":")[0]) / "settings.json"
         if os.environ.get("STATE_DIRECTORY") else None)
COMMAND_TIMEOUT_S = 10


def log(text):
    print(text, flush=True)


def load_settings():
    table = {}
    for path in [CONFIG, *sorted(CONFIG.parent.glob(CONFIG.stem + ".d/*.toml"))]:
        try:
            with open(path, "rb") as f:
                table.update(tomllib.load(f).get("ui", {}))
        except FileNotFoundError:
            continue
        except (OSError, tomllib.TOMLDecodeError) as e:
            log(f"rpi-audio-ui: {path}: {e}; file ignored")
    if SAVED:
        try:
            saved = json.loads(SAVED.read_text())
            table.update({k: v for k, v in saved.items() if k in uiservice.PREF_KEYS})
        except FileNotFoundError:
            pass
        except (OSError, ValueError, AttributeError) as e:
            log(f"rpi-audio-ui: {SAVED}: {e}; ignored")
    cfg, warnings = uiservice.settings(table)
    for w in warnings:
        log(f"rpi-audio-ui: {w}")
    return cfg


def save_prefs(prefs):
    """Keeps what the Settings screen changed; raises OSError when it cannot (or has nowhere to)."""
    if SAVED is None:
        raise OSError("no state directory")
    tmp = SAVED.with_suffix(".tmp")
    tmp.write_text(json.dumps(prefs))
    tmp.replace(SAVED)


def run_command(text):
    """Runs a confirmed local system action or an rpi-audiod command; empty string on success."""
    system = {'system poweroff': 'poweroff', 'system reboot': 'reboot'}
    if text.startswith('system ') and text not in system:
        return 'unknown system action'
    command = (['/usr/bin/sudo', '-n', '/usr/bin/systemctl', system[text]] if text in system else
               [AUDIOD, 'cmd', *text.split()])
    try:
        done = subprocess.run(command, capture_output=True, text=True, timeout=COMMAND_TIMEOUT_S)
    except (OSError, subprocess.TimeoutExpired) as e:
        return str(e)
    if done.returncode == 0:
        return ""
    return (done.stderr.strip().splitlines() or ["failed"])[-1].removeprefix("rpi-audiod: ")


def open_reader(cfg):
    """The GPIO lines, waiting for them as long as they are not there."""
    waited = False
    while True:
        try:
            return inputs.GpioReader(cfg.pins)
        except (OSError, ImportError) as e:
            if not waited:
                log(f"rpi-audio-ui: no GPIO yet: {e}")
            waited = True
            time.sleep(uiservice.RETRY_S)


def main():
    parser = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    parser.add_argument("action", nargs="?", choices=("run",), default="run")
    parser.parse_args()
    cfg = load_settings()
    stopping = []
    signal.signal(signal.SIGTERM, lambda *_: stopping.append(1))
    signal.signal(signal.SIGINT, lambda *_: stopping.append(1))
    reader = open_reader(cfg)
    level_meter = meters.Reader()

    display = sh1106.AsyncDisplay(
        lambda flip, contrast: sh1106.Display(sh1106.I2C(cfg.bus, cfg.address), flip, contrast),
        cfg.flip, cfg.contrast, log)

    with ThreadPoolExecutor(max_workers=1) as worker, ThreadPoolExecutor(max_workers=1) as sensors:
        monitor = telemetry.Monitor(sensors.submit)
        app = uiservice.App(reader, lambda: display, lambda: uiservice.read_status(STATUS), run_command, cfg, log,
                            save_prefs, submit_command=lambda text: worker.submit(run_command, text),
                            load_hardware=monitor.read, load_levels=level_meter.read, start_overview=True)
        app.start(time.monotonic())
        log(f"rpi-audio-ui: running (I2C bus {cfg.bus}, address {cfg.address:#04x})")
        next_slow_log = 0.0
        try:
            while not stopping:
                started = time.monotonic()
                app.step(started)
                elapsed = time.monotonic() - started
                if elapsed >= 0.25 and started >= next_slow_log:
                    log(f"rpi-audio-ui: slow input loop: {elapsed:.3f}s")
                    next_slow_log = started + 10
        finally:
            app.close()
            display.close()
            reader.close()
            level_meter.close()
    return 0


if __name__ == "__main__":
    sys.exit(main())
