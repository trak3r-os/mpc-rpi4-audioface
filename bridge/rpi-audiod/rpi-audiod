def read_version():
    """What install.sh wrote next to this script ("0.1.0 (3c48288)"), else the checkout's VERSION."""
    here = Path(__file__).resolve().parent
    for f, suffix in ((here / "VERSION", ""), (here.parent.parent / "VERSION", " (checkout)")):
        with contextlib.suppress(OSError):
            return f.read_text().strip() + suffix
    return "unknown"


VERSION = read_version()


def log(msg):
    print(msg, flush=True)


def load_config():
    cfg = {"gadget": {}, "engine": {}, "bridge": {}, "slots": {}, "midi": {}, "usb": {}}
    for path in [CONFIG, *sorted(CONFIG.parent.glob(CONFIG.stem + ".d/*.toml"))]:
        if path.exists():
            with open(path, "rb") as f:
                for table, values in tomllib.load(f).items():
                    cfg.setdefault(table, {}).update(values)
    selected = load_slots().get("engine_mode")
    if selected in ("host", "standalone", "hub"):
        cfg["engine"]["mode"] = selected
    return cfg


def load_profiles():
    """The device profiles in devices.d next to the config, in file name order; a file that
    does not parse, or has a bad `match`, is skipped with a warning."""
    profiles = []
    for path in sorted(CONFIG.parent.glob("devices.d/*.toml")):
        try:
            with open(path, "rb") as f:
                profile, warnings = audiod.parse_profile(tomllib.load(f), path.name)
        except (OSError, tomllib.TOMLDecodeError) as e:
            profile, warnings = None, [f"{path.name}: {e}; file ignored"]
        for w in warnings:
            log(f"rpi-audiod: profile {w}")
        if profile:
            profiles.append(profile)
    return profiles


def load_hosts():
    """The host profiles, {name: {"reserve_in": [...], ...}}: those in hosts.d next to the config (name
    being the file name without .toml; a file that does not parse is skipped with a warning), then the
    ones saved at runtime in hosts.json, which win."""
    hosts = {}
    for path in sorted(CONFIG.parent.glob("hosts.d/*.toml")):
        try:
            with open(path, "rb") as f:
                profile, warnings = audiod.parse_host(tomllib.load(f), path.name)
        except (OSError, tomllib.TOMLDecodeError) as e:
            profile, warnings = None, [f"{path.name}: {e}; file ignored"]
        for w in warnings:
            log(f"rpi-audiod: host profile {w}")
        if profile is not None:
            hosts[path.stem] = profile
    try:
        saved = json.loads(HOSTS.read_text())
    except (OSError, ValueError):
        saved = {}
    for name, entry in (saved.items() if isinstance(saved, dict) else ()):
        if not isinstance(entry, dict):
            log(f'rpi-audiod: host profile hosts.json {name}: expected an object; ignored')
            continue
        data = {'slots': entry, **({'preset': entry['preset']} if 'preset' in entry else {})}
        profile, warnings = audiod.parse_host(data, f'hosts.json {name}')
        if 'state' in entry:
            if not isinstance(entry['state'], dict) or 'preset' in entry:
                profile = None
                warnings.append(f'hosts.json {name}: invalid or conflicting setup; profile ignored')
            elif profile is not None:
                profile['state'] = copy.deepcopy(entry['state'])
        for w in warnings:
            log(f'rpi-audiod: host profile {w}')
        if profile is not None:
            hosts[name] = profile
    return hosts


def load_saved_hosts():
    try:
        data = json.loads(HOSTS.read_text())
    except (OSError, ValueError):
        return {}
    return data if isinstance(data, dict) else {}


def effective_reserved(cfg, slots, hosts):
    """{IN: [...], OUT: [...]}: the gadget channels held back. The selected host profile (the saved
    choice, else [host] profile) overrides [slots] of the configuration, key by key."""
    profile = hosts.get(slots.get("host_profile") or cfg.get("host", {}).get("profile") or "", {})
    return {d: profile.get(f"reserve_{d}", cfg["slots"].get(f"reserve_{d}", [])) for d in (IN, OUT)}


def gadget_setting(name, default):
    """GADGET_* from the environment (the unit's EnvironmentFile), else from gadget.env
    next to the config, so a run by hand sees the same gadget."""
    if name in os.environ:
        return os.environ[name]
    for line in read(CONFIG.parent / "gadget.env").splitlines():
        key, _, value = line.partition("=")
        if key.strip() == name:
            return value.strip().strip('"')
    return default


def run(*cmd, timeout=2):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired) as e:
        return subprocess.CompletedProcess(cmd, 1, "", str(e))


def read(path):
    try:
        return Path(path).read_text()
    except OSError:
        return ""


def read_bytes(path):
    try:
        return Path(path).read_bytes()
    except OSError:
        return b""


def write_json(path, data):
    """Replaces the file at once, through a temporary file of its own: two writers never
    share one. Readable by all, whoever writes it (the service or root at the command line)."""
    fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=path.name + ".")
    try:
        with os.fdopen(fd, "w") as f:
            f.write(json.dumps(data, indent=1, sort_keys=True) + "\n")
        os.chmod(tmp, 0o664 if path.parent == STATE.parent else 0o644)
        os.replace(tmp, path)
    except BaseException:
        with contextlib.suppress(OSError):
            os.unlink(tmp)
        raise


def load_slots():
    try:
        return json.loads(STATE.read_text())
    except (OSError, ValueError):
        return {}


def load_presets():
    try:
        data = json.loads(PRESETS.read_text())
    except (OSError, ValueError):
        return {}
    return data if isinstance(data, dict) else {}


def slots_stamp():
    """Changes with every write of slots.json (each one is a new file)."""
    try:
        st = STATE.stat()
        return st.st_ino, st.st_mtime_ns
    except OSError:
        return None


@contextlib.contextmanager
def locked():
    """The lock the service and the command line share around slots.json and presets.json."""
    fd = os.open(STATE.with_suffix(".lock"), os.O_RDONLY | os.O_CREAT, 0o644)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        os.close(fd)


def update_slots(change):
    """Applies change(state) -> state to slots.json, holding the lock, so neither the service
    nor the command line overwrites the other's edit. Returns (state, stamp)."""
    with locked():
        state = load_slots()
        new = change(copy.deepcopy(state))
        if new != state:
            write_json(STATE, new)
        return new, slots_stamp()


def update_presets(change):
    """Applies change(state, presets) -> (state, presets) to slots.json and presets.json under
    the same lock; a file is only written when it changed, and nothing when change raises."""
    with locked():
        state, store = load_slots(), load_presets()
        new, new_store = change(copy.deepcopy(state), copy.deepcopy(store))
        if new_store != store:
            write_json(PRESETS, new_store)
        if new != state:
            write_json(STATE, new)


def host_summary(cfg, hosts):
    """Small read-only metadata for the OLED; full snapshots stay in hosts.json."""
    saved, scenes = load_saved_hosts(), load_presets()

    def describe(profile, origin):
        slot = profile.get('preset')
        scene = scenes.get(str(slot), {})
        available = isinstance(scene, dict) and isinstance(scene.get('state'), dict)
        return {'origin': origin,
                'kind': 'snapshot' if 'state' in profile else 'preset' if slot is not None else 'reservations',
                **{f'reserve_{d}': profile.get(f'reserve_{d}', cfg.get('slots', {}).get(f'reserve_{d}', []))
                   for d in (IN, OUT)},
                **({'preset': slot, 'preset_available': available} if slot is not None else {})}
    result = {name: describe(profile, 'user' if name in saved else 'factory') for name, profile in hosts.items()}
    result['default'] = describe(hosts.get(cfg.get('host', {}).get('profile'), {}), 'configuration')
    return result


def save_host_command(cmd):
    """Apply a host and its setup atomically, or edit user-owned profiles under the state lock."""
    name, action = cmd.arg('name'), cmd.arg('action')
    with locked():
        state, cfg, hosts = load_slots(), load_config(), load_hosts()
        if action == 'select':
            if name != 'default' and name not in hosts:
                raise ValueError(f"unknown host profile {name}; known: {', '.join(hosts) or 'none'}")
            selected = name if name != 'default' else cfg.get('host', {}).get('profile')
            profile = hosts.get(selected, {})
            if 'preset' in profile:
                presets.load_preset(state, load_presets(), profile['preset'])
                presets.mark_active(state, profile['preset'])
            elif 'state' in profile:
                presets.restore_state(state, profile['state'])
                state.pop('active_scene', None)
            state, _ = midi.apply_command(state, cmd)
            write_json(STATE, state)
            return
        if action == 'preset':
            if name not in hosts:
                raise ValueError(f'unknown host profile {name}')
            slot = cmd.arg('preset')
            if slot is not None:
                presets.load_preset({}, load_presets(), slot)  # validate before writing anything
            profile = {f'reserve_{d}': hosts[name].get(f'reserve_{d}', cfg['slots'].get(f'reserve_{d}', []))
                       for d in (IN, OUT)}
            if slot is not None:
                profile['preset'] = slot
            store = load_saved_hosts()
            store[name] = profile
        else:
            if action == 'save' and cmd.arg('new', False) and name in hosts:
                raise ValueError(f'host profile {name} already exists; refresh and choose a new name')
            if action == 'rename' and cmd.arg('new_name') != name and cmd.arg('new_name') in hosts:
                raise ValueError(f"host profile {cmd.arg('new_name')} already exists")
            if action == 'save' and cmd.arg('preset') is not None:
                presets.load_preset({}, load_presets(), cmd.arg('preset'))
            current = effective_reserved(cfg, state, hosts)
            store = midi.apply_host(load_saved_hosts(), cmd, current, state)
        write_json(HOSTS, store)
        if (state.get('host_profile') or cfg.get('host', {}).get('profile')) == name:
            if action == 'delete':
                state.pop('host_profile', None)
            elif action == 'rename':
                state['host_profile'] = cmd.arg('new_name')
        write_json(STATE, state)  # refresh reservations; attaching a setup applies on the next explicit selection


def save_command(cmd):
    """Saves the change of an assign, mute, volume, name or preset Command. Raises ValueError
    (a command that cannot run, like loading an empty preset) or OSError (cannot write)."""
    if cmd.verb == "host":
        save_host_command(cmd)
        return
    if cmd.verb == "preset":
        update_presets(lambda state, store: midi.apply_preset(state, store, cmd, time.strftime("%Y-%m-%d %H:%M")))
    else:
        update_slots(lambda state: midi.apply_command(state, cmd)[0])


# Set by rpi-audio-gadget at boot; "usb latency low" in slots.json selects LOW_LATENCY_REQUESTS.
GADGET_REQUESTS = Path("/sys/kernel/config/usb_gadget/rpi-audio/functions/uac2.audio/req_number")
LOW_LATENCY_REQUESTS = 2


def usb_latency(state, live=GADGET_REQUESTS):
    """The selected USB latency, the gadget's live requests in flight, and whether a restart is
    still needed for the selection to apply."""
    selected = "low" if state.get("usb_latency") == "low" else "normal"
    try:
        requests = int(read(live).strip())
    except (OSError, ValueError):
        requests = None
    pending = requests is not None and (requests <= LOW_LATENCY_REQUESTS) != (selected == "low")
    return {"selected": selected, "requests": requests, "pending": pending}


def udc_state():
    return next((read(p).strip() for p in glob.glob("/sys/class/udc/*/state")), "")


class Child:
    """A process whose output goes to the log with a prefix; a line repeated in a row
    is logged once with a count (a stuck zita says "Starting synchronisation." forever).
    With on_line, each line goes to it instead. stop_signal is what stop() sends first."""

    def __init__(self, name, cmd, on_line=None, stop_signal=signal.SIGTERM, control=False):
        self.name, self.cmd, self.started, self.on_line = name, cmd, time.monotonic(), on_line
        self.stop_signal = stop_signal
        self.proc = subprocess.Popen(cmd, stdin=subprocess.PIPE if control else subprocess.DEVNULL,
                                     stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, errors="replace")
        if control:
            os.set_blocking(self.proc.stdin.fileno(), False)
        self.pump = threading.Thread(target=self._pump, daemon=True)
        self.pump.start()

    def _pump(self):
        last, count = None, 0
        for line in self.proc.stdout:
            line = line.rstrip()
            if self.on_line:
                self.on_line(line)
                continue
            if line == last:
                count += 1
                continue
            if count:
                log(f"[{self.name}] (previous line {count} more times)")
            log(f"[{self.name}] {line}")
            last, count = line, 0
        if count:
            log(f"[{self.name}] (previous line {count} more times)")

    def alive(self):
        return self.proc.poll() is None

    def send_level(self, percent):
        try:
            data = f'{percent}\n'.encode()
            return os.write(self.proc.stdin.fileno(), data) == len(data)
        except (OSError, ValueError, AttributeError):
            return False

    def stop(self, grace=1.0):
        if self.alive():
            self.proc.send_signal(self.stop_signal)
            try:
                self.proc.wait(grace)
            except subprocess.TimeoutExpired:
                log(f"rpi-audiod: {self.name} ignored {signal.Signals(self.stop_signal).name}, killing it")
                self.proc.kill()
                self.proc.wait()
        if self.proc.stdin:
            self.proc.stdin.close()
        self.pump.join(timeout=0.2)


class Device:
    """A USB audio card as found in /proc/asound, with what is read once when it is found:
    its profile, USB speed, bus and port, and the full-speed load of each direction."""

    def __init__(self, card, card_id, usbbus, ident, plans, profile=None, speed="", bus="", loads=None, port=""):
        self.card, self.id, self.usbbus, self.identity = card, card_id, usbbus, ident
        self.port = port   # sysfs path of the USB port it is plugged into ("1-2"), "" when unknown
        self.plans = plans  # {IN: (rate, channels) or None, OUT: ...}
        self.profile, self.speed, self.bus = profile, speed, bus
        self.loads = loads or {IN: None, OUT: None}   # B per frame; None when unknown
        self.kept = {d: audiod.kept_channels(p[1], profile.get("ignore", d) if profile else ()) if p else []
                     for d, p in plans.items()}   # the device channels that get a gadget slot


def usb_dir(card):
    """sysfs directory of the USB device a sound card hangs off, "" when there is none."""
    dev = os.path.realpath(f"/sys/class/sound/card{card}/device")
    for _ in range(3):  # the card hangs off the interface; the attributes are on the device
        dev = os.path.dirname(dev)
        if os.path.exists(f"{dev}/idVendor"):
            return dev
    return ""


def usb_attr(card, name):
    dev = usb_dir(card)
    return (read(f"{dev}/{name}").strip(), os.path.basename(dev)) if dev else ("", "")


def usb_cards(cfg):
    """(card, card_id, usbbus, identity) for every USB sound card, in card order."""
    found, ignore = [], set(cfg["bridge"].get("ignore", []))
    for d in sorted(glob.glob("/proc/asound/card[0-9]*"), key=lambda p: int(Path(p).name[4:])):
        usbbus = read(f"{d}/usbbus").strip()
        card_id = read(f"{d}/id").strip()
        if not usbbus or card_id in ignore:
            continue
        card = int(Path(d).name[4:])
        vendor, port = usb_attr(card, "idVendor")
        product, _ = usb_attr(card, "idProduct")
        serial, _ = usb_attr(card, "serial")
        found.append((card, card_id, usbbus, audiod.identity(vendor, product, serial, port)))
    return [(*c[:3], ident) for c, ident in zip(found, audiod.dedupe([c[3] for c in found]))]


def new_device(card, card_id, usbbus, ident, stream, cfg, profiles):
    """The Device for a card with PCM streams: profile, plans and full-speed loads, read once."""
    vendor, _ = usb_attr(card, "idVendor")
    product, _ = usb_attr(card, "idProduct")
    profile, warnings = audiod.match_profile(profiles, vendor, product, usb_attr(card, "bcdDevice")[0])
    for w in warnings:
        log(f"rpi-audiod: {card_id}: {w}")
    rates = cfg["bridge"].get("rates", [48000, 44100])
    if profile and profile.rate:
        rates = [profile.rate, *rates]
    plans = {IN: audiod.plan_direction(stream["capture"], rates),
             OUT: audiod.plan_direction(stream["playback"], rates)}
    speed, port = usb_attr(card, "speed")
    bus = usb_attr(card, "busnum")[0]
    active = usb_attr(card, "bConfigurationValue")[0]
    interfaces = usb.parse_descriptors(read_bytes(f"{usb_dir(card)}/descriptors"),
                                       int(active) if active.isdigit() else None)
    loads = {d: usb.direction_load(speed, stream[kind], plans[d], interfaces) if plans[d] else None
             for d, kind in ((IN, "capture"), (OUT, "playback"))}
    return Device(card, card_id, usbbus, ident, plans, profile, speed, bus, loads, port)


def scan(cfg, profiles, cache):
    """The USB cards with at least one PCM direction, and {card: identity} for every USB
    card, MIDI-only ones included. cache holds the Devices already found, so each is read once."""
    found, cards, seen = [], {}, {}
    for card, card_id, usbbus, ident in usb_cards(cfg):
        cards[card] = ident
        key = (card, usbbus, ident)
        dev = cache.get(key)
        if dev is None:
            stream = audiod.parse_stream(read(f"/proc/asound/card{card}/stream0"))
            if stream["capture"] or stream["playback"]:
                dev = new_device(card, card_id, usbbus, ident, stream, cfg, profiles)
        if dev:
            seen[key] = dev
            found.append(dev)
    cache.clear()
    cache.update(seen)
    return found, cards


class Bridge:
    """One direction of one device: a zita process, restarted with backoff."""

    def __init__(self, dev, direction):
        self.dev, self.direction = dev, direction
        self.client = audiod.client_name(dev.id, direction)
        self.rate, self.channels = dev.plans[direction]   # channels: what zita opens
        self.kept = dev.kept[direction]                   # the ones that get a gadget slot
        self.size = len(self.kept)
        self.load = dev.loads[direction] or 0             # full-speed B per frame
        self.blocked = None                               # why it does not start: the USB budget
        self.holding = False                              # has its share of the budget: started, not stopped
        self.placed = False                               # its gadget channels (or none) were logged
        self.child, self.backoff, self.next_try, self.start = None, 1.0, 0.0, None
        self.send_client = "system"
        self.gadget = True                                # False: no host, so no gadget channels to connect

    def routes(self):
        if self.start is None or not self.gadget:
            return []
        pairs = audiod.routes(self.client, self.direction, self.start, self.kept)
        if self.direction == IN and self.send_client != 'system':
            pairs = [(src, dst.replace('system:', self.send_client + ':', 1)) for src, dst in pairs]
        return pairs

    def check_budget(self, used, budget):
        """True when zita may start; otherwise records why, logging when that starts or ends."""
        why = usb.budget_reason(self.load, used, budget, self.dev.bus)
        if bool(why) != bool(self.blocked):
            log(f"rpi-audiod: {self.client} " + (f"waits, {why}" if why else "has USB budget again, starting"))
        self.blocked = why
        return why is None

    def tick(self, cfg, now, used=0, budget=0):
        """used: full-speed B per frame the other running bridges take on this device's bus."""
        if self.child and not self.child.alive():
            lived = now - self.child.started
            log(f"rpi-audiod: {self.client} exited after {lived:.1f} s (code {self.child.proc.returncode})")
            self.child = None
            self.backoff = 1.0 if lived > 60 else min(self.backoff * 2, 30.0)
            self.next_try = now + self.backoff
        if self.child or (self.start is None and self.gadget):
            self.blocked = None
        elif now >= self.next_try and self.check_budget(used, budget):
            b = cfg["bridge"]
            tool = "zita-a2j" if self.direction == IN else "zita-j2a"
            cmd = [tool, "-j", self.client, "-d", f"hw:CARD={self.dev.id}", "-r", str(self.rate),
                   "-c", str(self.channels), "-p", str(b.get("period", 256)), "-n", str(b.get("periods", 2))]
            log(f"rpi-audiod: starting {' '.join(cmd)}")
            # zita only leaves JACK cleanly on SIGINT; SIGTERM kills it mid-cycle and
            # jackd logs xruns until it drops the client.
            self.child = Child(self.client, cmd, stop_signal=signal.SIGINT)
            self.holding = True

    def stop(self, disconnect=True):
        """disconnect=False when jackd is going away too: a stuck server could hang it."""
        self.holding = False
        if self.child:
            for src, dst in self.routes() if disconnect else []:
                run("jack_disconnect", src, dst)  # avoids xrun bursts in jackd (f2-jack-bench)
            self.child.stop()
            self.child = None


class RawMidiOut:
    """One output of an ALSA raw MIDI device, kept open between writes (libasound through ctypes), so a reply is
    one write: no process to start and no sequencer subscription to make and drop each time. Non-blocking, with a
    deadline: a host that stops reading the gadget's MIDI cannot hold the sender up for long.

    Writes go out in small pieces with a pause between them. On the Pi's dwc2, a long burst of bulk MIDI to the host
    delays the gadget's isochronous audio IN: 1.5 KB of SysEx in one go cost empty audio packets and host stream
    restarts, while the same bytes in 64-byte pieces 6 ms apart did not (docs/hw/2026-10-30-boot-soak.md, section 9)."""
    EAGAIN = 11
    NONBLOCK = 2   # SND_RAWMIDI_NONBLOCK
    CHUNK = 64     # bytes per write
    GAP = 0.006    # seconds between writes

    def __init__(self, name, lib=None):
        self.name, self.handle = name, None
        self.lib = lib if lib is not None else self.load()

    @staticmethod
    def load():
        lib = ctypes.CDLL("libasound.so.2")
        lib.snd_rawmidi_open.argtypes = [ctypes.c_void_p, ctypes.POINTER(ctypes.c_void_p), ctypes.c_char_p,
                                         ctypes.c_int]
        lib.snd_rawmidi_write.argtypes = [ctypes.c_void_p, ctypes.c_char_p, ctypes.c_size_t]
        lib.snd_rawmidi_write.restype = ctypes.c_ssize_t
        lib.snd_rawmidi_close.argtypes = [ctypes.c_void_p]
        lib.snd_strerror.argtypes = [ctypes.c_int]
        lib.snd_strerror.restype = ctypes.c_char_p
        return lib

    def error(self, code):
        return self.lib.snd_strerror(code).decode(errors="replace")

    def open(self):
        h = ctypes.c_void_p()
        r = self.lib.snd_rawmidi_open(None, ctypes.byref(h), self.name.encode(), self.NONBLOCK)
        if r < 0:
            raise OSError(-r, f"cannot open {self.name}: {self.error(r)}")
        self.handle = h

    def close(self):
        if self.handle is not None:
            self.lib.snd_rawmidi_close(self.handle)
            self.handle = None

    def write(self, data, timeout=5.0):
        """Writes all of data, opening the device first if needed. On an error the device is closed, so the next
        write opens it again (the gadget may have come back as a new card)."""
        if self.handle is None:
            self.open()
        deadline = time.monotonic() + timeout
        while data:
            piece = data[:self.CHUNK]
            r = self.lib.snd_rawmidi_write(self.handle, piece, len(piece))
            if r == -self.EAGAIN:
                if time.monotonic() > deadline:
                    raise TimeoutError(f"{self.name}: the host is not reading")
                time.sleep(0.005)
            elif r < 0:
                self.close()
                raise OSError(-r, f"{self.name}: {self.error(r)}")
            else:
                data = data[r:]
                if data:
                    time.sleep(self.GAP)


class Midi:
    """The gadget's USB MIDI ports (docs/MIDI.md): every MIDI port of a USB device gets a
    port of its own, through kernel sequencer subscriptions, and the control port carries
    commands for rpi-audiod."""

    def __init__(self, cfg, ports, card_id):
        m = cfg["midi"]
        self.card_id, self.ports = card_id, ports
        self.control = int(m.get("control_port", 1))
        if not 1 <= self.control <= ports:
            log(f"rpi-audiod: [midi] control_port {self.control} is not one of the gadget's {ports} ports; using 1")
            self.control = 1
        self.channels = (int(m.get("channel_in", 16)), int(m.get("channel_out", 15)))
        if not all(1 <= c <= 16 for c in self.channels) or self.channels[0] == self.channels[1]:
            log(f"rpi-audiod: [midi] channel_in/channel_out {self.channels} must be two channels 1..16; using 16, 15")
            self.channels = (16, 15)
        self.client = None   # the gadget's sequencer client
        self.listener, self.next_listen, self.heard = None, 0.0, 0.0
        self.events, self.replies = queue.SimpleQueue(), queue.SimpleQueue()
        self.eps, self.assigned, self.parked, self.configured = [], {}, [], False
        self.raw = None   # RawMidiOut on the control port, once it worked; None: aplaymidi
        threading.Thread(target=self.sender, daemon=True).start()

    def port(self, cable):
        return f"{self.client}:{cable - 1}"

    def gadget_client(self, clients):
        card = os.path.basename(os.path.realpath(f"/proc/asound/{self.card_id}"))
        if not card.startswith("card"):
            return None
        return next((c.number for c in clients.values() if c.card == int(card[4:])), None)

    def on_line(self, line):   # the listener's thread
        event = midi.parse_aseqdump(line)
        if event:
            self.events.put(event)

    def listen(self, clients, conns, now):
        """Keeps aseqdump subscribed to the control port; restarts it when it dies or
        loses its subscription (the gadget came back as a new client)."""
        if self.listener and self.listener.alive():
            src = (self.client, self.control - 1)
            if any(s == src and d[0] in clients and clients[d[0]].pid == self.listener.proc.pid for s, d in conns):
                self.heard = now
                return
            if now - self.heard < 3:
                return
            log("rpi-audiod: the MIDI control listener lost its subscription, restarting it")
        elif self.listener:
            log(f"rpi-audiod: the MIDI control listener exited (code {self.listener.proc.returncode})")
        if self.listener:
            self.stop_listener()
        if now >= self.next_listen:
            self.listener = Child("midi-control", ["aseqdump", "-p", self.port(self.control)], self.on_line)
            self.heard, self.next_listen = now, now + 2.0

    def stop_listener(self):
        if self.listener:
            self.listener.stop()
            self.listener = None

    def tick(self, cards, now):
        clients, conns = midi.parse_aconnect(run("aconnect", "-l").stdout)
        client = self.gadget_client(clients)
        if client != self.client:
            log(f"rpi-audiod: gadget MIDI {f'on sequencer client {client}' if client is not None else 'gone'}")
            self.stop_listener()
            self.client = client
        if client is None:
            return
        self.listen(clients, conns, now)
        eps = midi.endpoints(clients, cards)
        out = {}

        def cables(state):
            saved = state.get("midi", {})
            out["assigned"], out["parked"], new = midi.assign_cables([e for e, _, _ in eps], saved,
                                                                     self.ports, self.control)
            if new != saved:
                state["midi"] = new
            return state

        try:
            update_slots(cables)
        except OSError as e:
            log(f"rpi-audiod: cannot save {STATE}: {e}")
            cables(load_slots())
        assigned, parked = out["assigned"], out["parked"]
        for e, c, _ in eps:
            if assigned.get(e) != self.assigned.get(e) or (e in parked) != (e in self.parked):
                where = f"port {assigned[e]}" if e in assigned else "parked: no free port"
                log(f"rpi-audiod: MIDI {clients[c].name} ({e}) -> gadget MIDI {where}")
        self.eps, self.assigned, self.parked = eps, assigned, parked
        configured = udc_state() == "configured"
        if configured != self.configured:
            log(f"rpi-audiod: host {'connected: routing' if configured else 'gone: unrouting'} MIDI")
            self.configured = configured
        caps = midi.parse_seq_caps(read("/proc/asound/seq/clients"))
        wanted = midi.wanted_subscriptions(eps, assigned, caps, client, configured)
        devices = {c.number for c in clients.values() if c.card in cards}
        for src, dst in midi.stale_subscriptions(conns, wanted, client, devices):
            if run("aconnect", "-d", "%d:%d" % src, "%d:%d" % dst).returncode == 0:
                log("rpi-audiod: unsubscribed MIDI %d:%d -> %d:%d" % (*src, *dst))
        for src, dst in wanted - conns:
            if run("aconnect", "%d:%d" % src, "%d:%d" % dst).returncode == 0:
                log("rpi-audiod: subscribed MIDI %d:%d -> %d:%d" % (*src, *dst))

    def drain(self, daemon):
        """Runs the commands that came in on the control port since the last tick. CCs of
        one control are coalesced: a Q-Link sweep sets the level once per tick. A Program
        Change loads a preset, after the CCs that came before it."""
        ccs = {}
        for _ in range(MIDI_COMMANDS):
            try:
                event = self.events.get_nowait()
            except queue.Empty:
                break
            if event[0] == "sysex":
                text = midi.sysex_text(event[1])
                if text is not None:
                    reply = daemon.command(text)
                    if text.split()[:1] not in (["status"], ["ping"]):   # a panel polls status every second
                        log(f"rpi-audiod: MIDI command '{text}': {reply[:60]}")
                    self.send(reply)
            elif event[0] == "cc" and event[1] in self.channels:
                cmd = midi.cc_command(*event[1:], self.channels, daemon.starts())
                if cmd is None:
                    log(f"rpi-audiod: MIDI CC {event[2]} on channel {event[1]}: no device there")
                else:
                    ccs[(cmd.verb, cmd.identity, cmd.arg("direction"))] = cmd
            elif event[0] == "pc" and event[1] == self.channels[0]:
                cmd = midi.program_command(event[1], event[2], self.channels[0])
                if cmd is None:
                    log(f"rpi-audiod: MIDI program {event[2]} on channel {event[1]}: no preset there")
                    continue
                for pending in ccs.values():
                    daemon.apply(pending)
                ccs.clear()
                log(f"rpi-audiod: MIDI program {event[2]}: preset {cmd.arg('slot')}: {daemon.apply(cmd)}")
        for cmd in ccs.values():
            daemon.apply(cmd)

    def send(self, text):
        if self.replies.qsize() >= MIDI_COMMANDS:
            log("rpi-audiod: MIDI replies are piling up; dropping one")
            return
        try:
            data = midi.sysex_hex(text, reply=True)
        except ValueError:
            data = midi.sysex_hex("error: the reply is not plain ASCII", reply=True)
        self.replies.put((self.port(self.control), bytes.fromhex(data.replace(" ", ""))))

    def raw_out(self):
        """The control port's raw MIDI output (its cable is the device's subdevice), or None to use aplaymidi."""
        if self.raw is None:
            try:
                self.raw = RawMidiOut(f"hw:CARD={self.card_id},DEV=0,SUBDEV={self.control - 1}")
            except OSError as e:
                log(f"rpi-audiod: no libasound for MIDI replies ({e}); using aplaymidi")
                self.raw = False
        return self.raw or None

    def sender(self):
        """Sends the replies in order, in a thread of its own, so a slow host never holds up the main loop, which
        supervises the gadget's feed. Through the raw MIDI device kept open; aplaymidi (about 0.2 s a reply) when
        that cannot be opened."""
        while True:
            self.send_one(*self.replies.get())

    def send_one(self, port, sysex):
        raw = self.raw_out()
        if raw:
            try:
                raw.write(sysex)
                return
            except (OSError, TimeoutError) as e:
                log(f"rpi-audiod: MIDI reply through {raw.name}: {e}; this one goes through aplaymidi")
        try:
            subprocess.run(["aplaymidi", "-d", "0", "-p", port, "-"], input=midi.smf_sysex(sysex),
                           capture_output=True, timeout=5)
        except (OSError, subprocess.TimeoutExpired) as e:
            log(f"rpi-audiod: cannot send the MIDI reply: {e}")

    def status(self):
        return {"card": self.card_id, "client": self.client, "ports": self.ports, "control_port": self.control,
                "host_connected": self.configured, "listening": bool(self.listener and self.listener.alive()),
                "endpoints": [{"endpoint": e, "port": self.assigned.get(e)} for e, _, _ in self.eps]}


class Daemon:
    def __init__(self, cfg):
        self.cfg = cfg
        g = cfg["gadget"]
        self.card = g.get("card", "UAC2Gadget")
        self.channels = int(gadget_setting("GADGET_CHANNELS", g.get("channels", 2)))
        self.usb_channels = self.channels
        self.usb_card = self.card
        self.ssize = int(gadget_setting("GADGET_SSIZE", g.get("sample_size", 4)))
        self.standalone = cfg["engine"].get("mode", "host") == "standalone"
        self.hub = cfg["engine"].get("mode", "host") == "hub"
        if cfg["engine"].get("mode", "host") not in ("host", "standalone", "hub"):
            log(f"rpi-audiod: [engine] mode {cfg['engine']['mode']!r} is not host, standalone or hub; using host")
        self.sink = {}               # standalone: the local card jackd drives, which routes can end in
        if self.standalone or self.hub:
            a = {**STANDALONE, **cfg.get("standalone", {})}
            self.sink = {"identity": str(a["identity"]), "name": str(a["name"]), "card": str(a["card"]),
                         "channels": int(a["channels"]), "rate": int(a["rate"]),
                         "period": int(a["period"]), "periods": int(a["periods"])}
            self.card, self.channels, self.ssize = self.sink["card"], self.sink["channels"], 4
        self.pending = None          # feeder seen on the last tick
        self.target = None           # feeder the host's rates call for, once seen on two ticks
        self.mode = None             # what feeds the gadget now: "jack", "silence" or None
        self.rate = 0
        self.jackd = self.player = None
        self.jack_ready = False
        self.jack_fails, self.fallback_until = 0, 0.0
        self.ptr, self.ptr_moved = None, 0.0
        self.devices, self.bridges = {}, {}   # identity -> Device; (identity, direction) -> Bridge
        self.cards = {}                      # card number -> identity, every USB card
        self.muted = {IN: set(), OUT: set()}
        self.routes = []                     # device-to-device routes (routing.py)
        self.route_state = {}                # Route -> why it is not made yet, "" when it is
        self.midi_links = []                 # device-to-device MIDI routes (midiroute.py)
        self.midi_state = {}                 # Link -> why it is not made yet, "" when it is
        self.midi_ports = []                 # the devices' MIDI ports, for the status
        self.midi_made = set()               # subscriptions this service made (host mode drops only those)
        self.volumes = {}                    # (identity, direction) -> level last set
        self.seen_usbbus = set()
        self.profiles, self.known = load_profiles(), {}   # device profiles; scan()'s cache
        try:
            self.fs_budget = max(int(cfg["usb"].get("fs_budget", usb.FS_BUDGET)), 0)
        except (TypeError, ValueError):
            log(f"rpi-audiod: [usb] fs_budget {cfg['usb']['fs_budget']!r} is not a number; using {usb.FS_BUDGET}")
            self.fs_budget = usb.FS_BUDGET
        try:   # frames per period of the gadget bridges: 4 periods of this size buffer each direction
            self.host_period = min(max(int(cfg["usb"].get("host_period", 256)), 32), 256)
        except (TypeError, ValueError):
            log(f"rpi-audiod: [usb] host_period {cfg['usb']['host_period']!r} is not a number; using 256")
            self.host_period = 256
        # Hub: what bridges the gadget to JACK. "native" is rpi-audio-hostbridge (bridge/audio/hostbridge.c).
        self.host_bridge = cfg["usb"].get("host_bridge", "zita")
        if self.host_bridge not in ("zita", "native"):
            log(f"rpi-audiod: [usb] host_bridge {self.host_bridge!r} is not zita or native; using zita")
            self.host_bridge = "zita"
        self.host_bridge_missing = False   # native asked for, helper not built: said once
        self.host_margin_us = self.usb_number("host_margin_ms", 1.5, 0.25, 20.0, lambda v: round(v * 1000))
        self.host_quality = self.usb_number("host_quality", 32, 8, 96, int)
        self.slots_stamp = None
        self.unknown_host = None   # the host profile already warned about
        ports = 0 if self.standalone else int(gadget_setting("GADGET_MIDI_PORTS", 0))
        midi_id = gadget_setting("GADGET_MIDI_ID", cfg["midi"].get("card", "MIDIGadget"))
        self.midi = Midi(cfg, ports, midi_id) if ports else None
        self.rates = (0, 0)
        self.next_scan = self.next_routes = self.next_status = self.next_midi = self.next_midi_routes = 0.0
        self.stopping = False
        self.restart_requested = False
        self.output_state = load_slots()  # initial gain must be correct before any source is connected
        self.output_workers, self.output_metrics = {}, {}
        self.output_retry = {}
        self.next_outputs = 0.0
        self.sdp_server = None
        self.sdp_error = ""
        self.next_sdp = 0.0
        self.level_sent, self.level_links = {}, set()
        self.session = incidents.Session(STATUS.with_name('session.json'), clock=time.monotonic,
                                         wall=lambda: time.strftime('%Y-%m-%d %H:%M:%S'))
        self.next_observation = 0.0
        self.last_observation = None
        self.first_scan = True
        self.observer_seen = None
        self.note("monitor_starts", "Session monitor started")
        try:
            self.network = outputs.network(cfg.get("network", {}))
            self.network_error = ""
        except (ValueError, TypeError) as error:
            self.network, self.network_error = None, str(error)
        if self.hub:
            update_slots(outputs.migrate_host_routes)

    def usb_number(self, key, default, low, high, convert):
        """A numeric [usb] setting within its limits, converted; the default (with a warning) otherwise."""
        value = self.cfg["usb"].get(key, default)
        if isinstance(value, bool) or not isinstance(value, (int, float)) or not low <= value <= high:
            log(f"rpi-audiod: [usb] {key} {value!r} is not a number from {low} to {high}; using {default}")
            value = default
        return convert(value)

    def host_bridge_command(self, tool, client, rate):
        """The process that bridges one direction of the gadget in hub mode: rpi-audio-hostbridge when
        [usb] host_bridge = "native" and it is built, else zita-a2j / zita-j2a."""
        helper = Path(__file__).resolve().parent / "audio/rpi-audio-hostbridge"
        if self.host_bridge == "native":
            if os.access(helper, os.X_OK):
                return [str(helper), "--client", client, "--device", f"hw:CARD={self.usb_card}",
                        "--direction", "capture" if tool == "zita-a2j" else "playback", "--rate", str(rate),
                        "--channels", str(self.usb_channels), "--margin-us", str(self.host_margin_us),
                        "--quality", str(self.host_quality)]
            if not self.host_bridge_missing:
                log(f"rpi-audiod: [usb] host_bridge is native but {helper} is not built; using zita")
                self.host_bridge_missing = True
        # u_audio refuses fewer than 4 periods (PERIODS [4 16] on 6.18 rpi-2712) and
        # periods over one page, and zita then fails to open the gadget card.
        return [tool, "-j", client, "-d", f"hw:CARD={self.usb_card}", "-r", str(rate),
                "-c", str(self.usb_channels), "-p", str(self.host_period), "-n", "4"]

    def note(self, kind, detail, count=1, severity='info'):
        if hasattr(self, 'session'):
            self.session.event(kind, detail, count, severity)

    def observe_system(self, now):
        if now < self.next_observation:
            return
        self.next_observation = now + 0.5
        observation = (udc_state(), self.rates)
        if self.last_observation is not None:
            old_usb, old_rates = self.last_observation
            usb_state, rates = observation
            if old_usb != usb_state:
                if usb_state == 'not attached' and old_usb not in ('', 'unknown', 'not attached'):
                    self.note('usb_disconnects', 'USB host disconnected', severity='warning')
                elif usb_state == 'configured':
                    self.note('usb_connections', 'USB host connected')
            for side, before, after in zip(('to host', 'from host'), old_rates, rates):
                if before and after and before != after:
                    self.note('rate_changes', f'USB {side}: {before} -> {after} Hz')
                elif before and not after:
                    self.note('stream_stops', f'USB {side}: stream stopped')
                elif after and not before:
                    self.note('stream_starts', f'USB {side}: {after} Hz')
        self.last_observation = observation
        try:
            self.session.flush(write_json)
        except OSError as error:
            log(f'rpi-audiod: cannot retain session history: {error}')

    # --- what feeds the gadget -------------------------------------------------------

    def host_rates(self):
        c = audiod.parse_controls(run("amixer", "-c", self.usb_card, "contents").stdout)
        return c.get("Playback Rate", 0), c.get("Capture Rate", 0)

    def start_jackd(self):
        e = self.cfg["engine"]
        if self.standalone or self.hub:
            k = self.sink   # playback only (-P): a pHAT DAC has no capture
            cmd = ["jackd", "-R", "-P", str(e.get("priority", 70)), "-t", "2000", "-d", "alsa", "-d", f"hw:{self.card}",
                   "-P", "-r", str(k["rate"]), "-p", str(k["period"]), "-n", str(k["periods"]),
                   "-o", str(k["channels"])]
            log(f"rpi-audiod: starting {' '.join(cmd)}")
            self.jackd, self.jack_ready = Child("jackd", cmd), False
            return
        # hw:NAME, not hw:CARD=NAME: jackd's card reservation cannot parse the latter.
        cmd = ["jackd", "-R", "-P", str(e.get("priority", 70)), "-t", "2000", "-d", "alsa",
               "-d", f"hw:{self.card}", "-r", str(self.rate), "-p", str(e.get("period", 64)),
               "-n", str(e.get("periods", 3)), "-i", str(self.channels), "-o", str(self.channels)]
        if self.ssize == 2:
            cmd.append("-S")
        log(f"rpi-audiod: starting {' '.join(cmd)}")
        self.jackd, self.jack_ready = Child("jackd", cmd), False

    def start_player(self):
        fmt = {2: "S16_LE", 3: "S24_3LE", 4: "S32_LE"}[self.ssize]
        cmd = ["aplay", "-q", "-D", f"hw:CARD={self.card}", "-t", "raw", "-f", fmt,
               "-c", str(self.channels), "-r", str(self.rate), "/dev/zero"]
        log(f"rpi-audiod: playing silence ({self.channels} ch {fmt} {self.rate} Hz)")
        self.player = Child("silence", cmd)

    def stop_feeder(self):
        if self.sdp_server:
            self.sdp_server.close()
            self.sdp_server = None
        self.level_links.clear()
        self.level_sent.clear()
        for child in self.output_workers.values():
            child.stop()
        self.output_workers.clear()
        self.output_metrics.clear()
        for b in self.bridges.values():
            b.stop(disconnect=False)
        if self.jackd:
            self.jackd.stop()
        if self.player:
            self.player.stop()
        self.jackd = self.player = None
        self.jack_ready = False

    def set_mode(self, mode, now):
        if mode == "jack" and now < self.fallback_until:
            mode = None if self.standalone or self.hub else "silence"
        if mode == self.mode and (self.jackd or self.player or mode is None):
            return
        self.stop_feeder()
        self.mode, self.ptr, self.ptr_moved = mode, None, now
        if mode == "jack":
            self.start_jackd()
        elif mode == "silence":
            self.start_player()

    def check_feeder(self, now):
        """Restarts the feeder when it died or the gadget's playback pointer stopped:
        jackd's ALSA driver can stop while the process lives on (f2-jack-bench)."""
        child = self.jackd or self.player
        if child is None:
            return
        state, ptr = audiod.pcm_status(read(f"/proc/asound/{self.card}/pcm0p/sub0/status"))
        if ptr != self.ptr:
            self.ptr, self.ptr_moved = ptr, now
        died = not child.alive()
        stalled = now - child.started > STARTUP_S and now - self.ptr_moved > STALL_S
        if not died and not stalled:
            if self.jackd and now - child.started > 5:
                self.jack_fails = 0
            return
        log(f"rpi-audiod: {child.name} {'exited' if died else f'stalled ({state}, pointer still)'}, restarting")
        self.note("engine_faults", f"{child.name}: exited" if died else f"{child.name}: stalled",
                  severity="warning")
        if self.jackd:
            self.jack_fails += 1
            if self.jack_fails >= JACK_FAILS:
                log(f"rpi-audiod: jackd failed {self.jack_fails} times in a row; "
                    + ("waiting" if self.standalone or self.hub else "silence") + f" for {FALLBACK_S:.0f} s")
                self.jack_fails, self.fallback_until = 0, now + FALLBACK_S
        self.stop_feeder()
        self.mode = None   # set_mode starts it again on the next tick

    def check_jack_ready(self):
        if self.jackd and not self.jack_ready and run("jack_lsp").returncode == 0:
            self.jack_ready = True
            self.next_outputs = self.next_routes = 0.0
            log("rpi-audiod: jackd is up")

    # --- devices, slots and routes -----------------------------------------------------

    def reassign(self):
        """Gives the devices their gadget channels: decided and saved under the lock, then the
        bridges move (stopping one can take a second; nothing waits for that under the lock)."""
        if self.standalone:
            self.place_without_gadget()
            return
        hosts = load_hosts()
        assigned, moves = {}, []

        def allocate(slots):
            moves[:] = presets.follow_moves(slots, set(self.devices))
            reserved = self.reserved(slots, hosts)
            if self.hub:
                outputs.migrate_host_routes(slots)
            for direction in (IN, OUT):
                sizes = slots.setdefault(direction + "_channels", {})
                present = {i: len(dev.kept[direction]) for i, dev in self.devices.items() if dev.kept[direction]}
                preferred = {i: dev.profile.get("start", direction) for i, dev in self.devices.items()
                             if dev.profile and dev.profile.get("start", direction)}
                assigned[direction], _, slots[direction] = audiod.allocate(
                    present, slots.get(direction, {}), sizes,
                    self.usb_channels if self.hub else self.channels, reserved[direction],
                    preferred=preferred)
                sizes.update(present)
            return slots

        try:
            slots, self.slots_stamp = update_slots(allocate)
        except OSError as e:
            log(f"rpi-audiod: cannot save {STATE}: {e}")
            slots, self.slots_stamp = allocate(load_slots()), slots_stamp()
        self.say_moves(moves)
        for direction in (IN, OUT):
            for i in self.devices:
                b = self.bridges.get((i, direction))
                if b and (b.start != assigned[direction].get(i) or not b.placed):
                    if b.gadget and b.start is not None:
                        b.stop()
                    b.start, b.placed = assigned[direction].get(i), True
                    log(f"rpi-audiod: {b.client} -> gadget {direction.upper()} "
                        + (f"{b.start}-{b.start + b.size - 1}" if b.start else "parked: no free channels"))
        self.take_state(slots)

    def say_moves(self, moves):
        """Logs and records the devices whose saved state followed them to another USB port (presets.follow_moves)."""
        for old, new in moves:
            where = " from {} to {}".format(*(audiod.by_port(i)[0] for i in (old, new)))
            text = f"{self.devices[new].id} moved{where}: routes follow"
            log(f"rpi-audiod: {text}")
            self.note("device_moves", text)

    def host_name(self, slots):
        """The selected host profile: the saved choice (`host NAME`), else [host] profile, else None."""
        return slots.get("host_profile") or self.cfg.get("host", {}).get("profile") or None

    def reserved(self, slots, hosts):
        """effective_reserved, saying once when the selected profile does not exist."""
        name = self.host_name(slots)
        if name and name not in hosts and name != self.unknown_host:
            log(f"rpi-audiod: no host profile {name} in hosts.d; using [slots] of the configuration")
        self.unknown_host = name if name not in hosts else None
        return effective_reserved(self.cfg, slots, hosts)

    def place_without_gadget(self):
        """Standalone: no gadget channels to give out (and the saved ones, the host mode's, stay as they are).
        A bridge only needs a mark that it may run."""
        moves = []

        def follow(slots):
            moves[:] = presets.follow_moves(slots, set(self.devices))
            return slots

        try:
            slots, self.slots_stamp = update_slots(follow)
        except OSError as e:
            log(f"rpi-audiod: cannot save {STATE}: {e}")
            slots, self.slots_stamp = load_slots(), slots_stamp()
        self.say_moves(moves)
        for b in self.bridges.values():
            if not b.placed:
                b.start, b.placed = 1, True
                log(f"rpi-audiod: {b.client} ready (standalone: routes only)")
        self.take_state(slots)

    def take_state(self, slots):
        """The saved mutes, device-to-device routes and levels."""
        self.muted = {d: set(slots.get("mute", {}).get(d, [])) for d in (IN, OUT)}
        self.output_state = slots
        selected = slots.get("engine_mode", self.cfg["engine"].get("mode", "host"))
        if selected in ("host", "standalone", "hub") and selected != self.cfg["engine"].get("mode", "host"):
            self.restart_requested, self.stopping = True, True
        for identity in outputs.IDS:
            if not outputs.enabled(slots, identity, identity not in (outputs.RTP, outputs.LINK)):
                self.muted[OUT].add(identity)
        if self.sink and not outputs.enabled(slots, "local-dac"):
            self.muted[OUT].add(self.sink["identity"])
        self.routes = routing.from_state(slots)
        self.midi_links = midiroute.from_state(slots)
        self.set_volumes(slots.get("volume", {}))

    def set_volumes(self, saved):
        """Sets each device's saved levels (docs/MIDI.md) when they changed or it came back."""
        for i, dev in self.devices.items():
            for direction, kind in ((IN, "capture"), (OUT, "playback")):
                level = saved.get(direction, {}).get(i)
                if level is None or self.volumes.get((i, direction)) == level:
                    continue
                controls = audiod.volume_controls(run("amixer", "-c", dev.id, "scontents").stdout, direction)
                for control in controls:
                    run("amixer", "-q", "-c", dev.id, "sset", control, kind, f"{level}%")
                log(f"rpi-audiod: {dev.id}: {kind} level {level}% on {', '.join(controls) or 'no control'}")
                self.volumes[(i, direction)] = level

    def raise_volumes(self, dev):
        if dev.identity in load_slots().get("volume", {}).get(OUT, {}):
            return   # set_volumes sets the saved level instead
        floor = self.cfg["bridge"].get("min_volume", "80%")
        for control in audiod.silent_volumes(run("amixer", "-c", dev.id, "scontents").stdout):
            log(f"rpi-audiod: {dev.id}: '{control}' playback volume was 0, setting {floor}")
            run("amixer", "-q", "-c", dev.id, "sset", control, floor, "unmute")

    def scan_devices(self):
        found, self.cards = scan(self.cfg, self.profiles, self.known)
        found = {d.identity: d for d in found}
        changed = False
        for i, dev in list(self.devices.items()):
            new = found.get(i)
            if new is None or new.usbbus != dev.usbbus or new.card != dev.card:
                why = "unplugged" if new is None else "re-enumerated"
                log(f"rpi-audiod: {dev.id} ({i}) {why}")
                self.note("device_disconnects" if new is None else "device_reenumerations",
                          f"{dev.id}: {why}", severity="warning")
                for direction in (IN, OUT):
                    b = self.bridges.pop((i, direction), None)
                    if b:
                        b.stop()
                    self.volumes.pop((i, direction), None)
                del self.devices[i]
                changed = True
        for i, dev in found.items():
            if i in self.devices:
                continue
            plans = ", ".join(f"{d} {p[1]} ch {p[0]} Hz" for d, p in dev.plans.items() if p)
            log(f"rpi-audiod: {dev.id} ({i}) on card {dev.card}: {plans}"
                + (f", profile {dev.profile.source}" if dev.profile else ""))
            log(f"rpi-audiod: {dev.id}: USB bus {dev.bus or '?'}, speed {dev.speed or '?'} Mbit/s, full-speed load "
                + ", ".join(f"{d} {'unknown, not checked' if v is None else f'{v} B'}"
                            for d, v in dev.loads.items() if dev.plans[d]))
            self.devices[i] = dev
            if not self.first_scan:
                self.note("device_connections", f"{dev.id}: connected")
            for direction in (IN, OUT):
                if dev.plans[direction] and not dev.kept[direction]:
                    log(f"rpi-audiod: {dev.id}: the profile ignores every {direction.upper()} channel; no bridge")
                elif dev.plans[direction]:
                    self.bridges[(i, direction)] = Bridge(dev, direction)
                    self.bridges[(i, direction)].gadget = not (self.standalone or self.hub)
                    if direction == IN and not (self.standalone or self.hub):
                        self.bridges[(i, direction)].send_client = outputs.LEVEL_CLIENTS[outputs.USB]
            if dev.usbbus not in self.seen_usbbus:
                self.seen_usbbus.add(dev.usbbus)
                self.raise_volumes(dev)
            changed = True
        self.first_scan = False
        if changed or slots_stamp() != self.slots_stamp:
            self.reassign()

    def bus_used(self, bridge):
        """Full-speed B per frame the other bridges hold on this bridge's USB bus: running, or waiting to restart
        after a crash, so a bridge that was blocked behind one does not take its place in the meantime."""
        return sum(b.load for b in self.bridges.values()
                   if b is not bridge and b.dev.bus == bridge.dev.bus and b.holding)

    def usb_buses(self):
        """[{bus, fs_load, fs_demand, fs_budget}] for each USB bus with an audio device: fs_load is what
        bus_used() counts there (bridges holding their share), fs_demand what every bridge of that bus
        would take, so a bridge held back for the budget shows as demand above the load."""
        found = {}
        for dev in self.devices.values():
            bus = usb.bus_number(dev.bus)
            if bus is not None:
                found.setdefault(bus, {"bus": bus, "fs_load": 0, "fs_demand": 0, "fs_budget": self.fs_budget})
        for b in self.bridges.values():
            entry = found.get(usb.bus_number(b.dev.bus))
            if entry:
                entry["fs_demand"] += b.load
                entry["fs_load"] += b.load if b.holding else 0
        return [found[bus] for bus in sorted(found)]

    def usb_entry(self, dev, labels):
        """What status.json says of where a device is plugged in; fields that are not known are left out."""
        info = {"bus": usb.bus_number(dev.bus), "port": dev.port or None, "speed": usb.speed_mbit(dev.speed),
                "label": labels.get(dev.port),
                # a serial-less identity is made of the port, so the device loses its routes when moved
                "by_port": dev.identity.startswith(f"usb-{dev.port}-") if dev.port else None}
        return {k: v for k, v in info.items() if v is not None}

    def connect_routes(self):
        ports, pairs = audiod.parse_connections(run("jack_lsp", "-c").stdout)
        for (i, direction), b in self.bridges.items():
            muted = (i in self.muted[direction] or
                     (direction == IN and not (self.standalone or self.hub) and
                      not outputs.enabled(self.output_state, outputs.USB)))
            for src, dst in b.routes():
                connected = frozenset((src, dst)) in pairs
                if muted and connected:
                    if run("jack_disconnect", src, dst).returncode == 0:
                        pairs.discard(frozenset((src, dst)))
                        log(f"rpi-audiod: muted {src} -> {dst}")
                elif not muted and not connected and src in ports and dst in ports:
                    if run("jack_connect", src, dst).returncode == 0:
                        pairs.add(frozenset((src, dst)))
                        log(f"rpi-audiod: connected {src} -> {dst}")
        self.connect_device_routes(ports, pairs)

    def connect_device_routes(self, ports, pairs):
        """Brings the connections between the bridges to the stored device-to-device routes."""
        bridges = {key: (b.client, b.channels) for key, b in self.bridges.items() if b.child and b.child.alive()}
        clients = {b.client for b in self.bridges.values()}
        if self.sink:
            clients.add("system")

        def gain(identity):
            child = self.output_workers.get('level-' + identity)
            return outputs.LEVEL_CLIENTS[identity] if child and child.alive() else None

        level_links = set()
        for identity, client in outputs.LEVEL_CLIENTS.items():
            clients.add(client)
            if not gain(identity) or not outputs.enabled(self.output_state, identity,
                                                         identity not in (outputs.RTP, outputs.LINK)):
                continue
            target, channels = None, 2
            if identity == 'local-dac' and self.sink:
                target, channels = 'system', self.sink['channels']
                bridges[(self.sink['identity'], OUT)] = (client, channels)
                clients.add('system')
            elif identity == outputs.USB:
                child = self.output_workers.get('usb-send')
                if self.hub and child and child.alive():
                    target = 'usb_host_out'
                elif not (self.hub or self.standalone):
                    target = 'system'
                channels = self.usb_channels
                if self.hub and target:
                    bridges[(outputs.USB, OUT)] = (client, channels)
            elif identity in (outputs.RTP, outputs.LINK):
                child = self.output_workers.get(identity)
                if child and child.alive():
                    target = 'network_rtp_out' if identity == outputs.RTP else 'network_link_out'
                    bridges[(identity, OUT)] = (client, 2)
                    clients.add(target)
            if target:
                level_links.update((f'{client}:capture_{n}', f'{target}:playback_{n}')
                                   for n in range(1, channels + 1))
        if self.hub:
            child = self.output_workers.get('usb-receive')
            if child and child.alive():
                bridges[(outputs.USB, IN)] = ('usb_host_in', self.usb_channels)
                clients.add('usb_host_in')
        want, pending = routing.wanted(self.routes, bridges, self.muted, ports)
        # Legacy gadget connections remain ours while host mode is using the USB gain stage.
        if not (self.hub or self.standalone):
            for (identity, side), bridge in self.bridges.items():
                if identity not in self.muted[side] and (side != IN or outputs.enabled(self.output_state, outputs.USB)):
                    want.update((a, b) for a, b in bridge.routes() if a in ports and b in ports)
        for src, dst in self.level_links - level_links:
            if frozenset((src, dst)) in pairs:
                if run('jack_disconnect', src, dst).returncode == 0:
                    pairs.discard(frozenset((src, dst)))
        self.level_links = level_links
        want.update((src, dst) for src, dst in level_links if src in ports and dst in ports)
        self.route_state = {r: "" for r in self.routes}
        self.route_state.update(pending)
        connect, disconnect = routing.reconcile(want, pairs, clients)
        for src, dst in disconnect:
            if run("jack_disconnect", src, dst).returncode == 0:
                log(f"rpi-audiod: removed {src} -> {dst}")
        for src, dst in connect:
            if run("jack_connect", src, dst).returncode == 0:
                log(f"rpi-audiod: connected {src} -> {dst}")

    def output_line(self, identity, line):
        try:
            data = json.loads(line)
            if isinstance(data, dict) and data.get("event") == "status":
                previous = self.output_metrics.get(identity, {})
                self.output_metrics[identity] = data
                if identity == 'observer':
                    self.observer_seen = time.monotonic()
                    self.session.observe('observer/xruns', data.get('xruns'), 'xruns', 'JACK xrun notifications')
                    for field, kind in (('rate', 'rate_changes'), ('period', 'buffer_changes')):
                        value = data.get(field)
                        if type(value) is int and value > 0:
                            before = self.session.value('engine_' + field, value)
                            if before and before != value:
                                self.note(kind, f'JACK {field}: {before} -> {value}')
                elif identity.startswith('usb-'):   # rpi-audio-hostbridge, one per direction
                    self.session.observe(identity + '/resyncs', data.get('resyncs'), 'usb_resyncs',
                                         f'{self.adapter_label(identity)}: jumped back to its buffer margin')
                elif identity in (outputs.RTP, outputs.LINK):
                    if (identity == outputs.LINK and previous.get('state') == 'sending' and
                            data.get('state') == 'waiting'):
                        self.note('network_stops', 'Link Audio stopped delivering buffers', severity='warning')
                    self.session.observe(identity + '/dropped', data.get('dropped_frames'),
                                         'network_dropped_frames', identity + ': dropped audio frames')
        except ValueError:
            if line.strip():
                log(f"[{identity}] {line}")

    def adapter_label(self, key):
        names = {'local-dac': self.sink.get('name', 'pHAT DAC'), outputs.USB: 'USB host',
                 outputs.RTP: 'Network RTP', outputs.LINK: 'Link Audio', 'observer': 'Audio monitor',
                 'usb-send': 'USB send', 'usb-receive': 'USB return'}
        if key.startswith('level-'):
            return names.get(key[len('level-'):], key) + ' level'
        return names.get(key, key)

    def sync_outputs(self, now):
        """Independent clients: changing an output never restarts the local JACK clock."""
        if now < self.next_outputs:
            return
        self.next_outputs = now + 0.5
        if self.hub:
            self.rates = self.host_rates()
        desired = {}
        if self.jack_ready:
            if self.hub:
                for key, rate, client, tool in (("usb-send", self.rates[0], "usb_host_out", "zita-j2a"),
                                                ("usb-receive", self.rates[1], "usb_host_in", "zita-a2j")):
                    if rate:
                        desired[key] = self.host_bridge_command(tool, client, rate)
            helper = str(Path(__file__).resolve().parent / "network/rpi-audio-network")
            for identity, transport, client in ((outputs.RTP, "rtp", "network_rtp_out"),
                                                (outputs.LINK, "link", "network_link_out")):
                if not outputs.enabled(self.output_state, identity, False) or self.network_error:
                    continue
                desired[identity] = [helper, "--transport", transport, "--client", client,
                                     "--address", self.network["address"], "--port", str(self.network["port"]),
                                     "--ttl", str(self.network["ttl"]),
                                     "--sdp", str(STATUS.with_name("network-rtp.sdp"))]
        helper = str(Path(__file__).resolve().parent / 'audio/rpi-audio-gain')
        if self.jack_ready:
            desired['observer'] = [helper, '--client', 'rpi_audio_session', '--channels', '0']
            targets = []
            if self.sink:
                targets.append(('local-dac', self.sink['channels']))
            if (self.hub and self.rates[0]) or not (self.hub or self.standalone):
                targets.append((outputs.USB, self.usb_channels))
            targets += [(identity, 2) for identity in (outputs.RTP, outputs.LINK) if identity in desired]
            for identity, channels in targets:
                desired['level-' + identity] = [helper, '--client', outputs.LEVEL_CLIENTS[identity],
                                                '--channels', str(channels), '--level',
                                                str(outputs.level(self.output_state, identity))]
        for key, child in list(self.output_workers.items()):
            compare = lambda command: command[:-2] if key.startswith('level-') else command  # noqa: E731
            if key not in desired or compare(child.cmd) != compare(desired[key]) or not child.alive():
                failed = not child.alive()
                if failed:
                    self.output_retry[key] = now + 5.0
                    self.note('adapter_failures', f'{self.adapter_label(key)}: stopped', severity='warning')
                child.stop()
                del self.output_workers[key]
                if not failed:
                    self.output_metrics.pop(key, None)
                elif key not in self.output_metrics or not self.output_metrics[key].get("error"):
                    self.output_metrics[key] = {"error": f"Adapter exited (code {child.proc.returncode})"}
                self.next_routes = 0.0
        for key, command in desired.items():
            if key in self.output_workers or now < self.output_retry.get(key, 0):
                continue
            try:
                self.session.reset_observer(key + ('/xruns' if key == 'observer' else '/resyncs'
                                                   if key.startswith('usb-') else '/dropped'))
                if key == 'observer':
                    self.observer_seen = None
                self.output_metrics.pop(key, None)
                self.output_workers[key] = Child(key, command, stop_signal=signal.SIGINT if key.startswith("usb-")
                                                 else signal.SIGTERM,
                                                 on_line=None if command[0].startswith("zita-") else
                                                 lambda line, identity=key: self.output_line(identity, line),
                                                 control=key.startswith("level-"))
                if key.startswith('level-'):
                    self.level_sent[key] = int(command[-1])
                self.next_routes = 0.0
            except OSError as error:
                if not self.output_metrics.get(key, {}).get('error'):
                    self.note('adapter_failures', f'{self.adapter_label(key)}: {error}', severity='warning')
                self.output_metrics[key] = {"error": str(error)}
                self.output_retry[key] = now + 5.0

        for key, child in self.output_workers.items():
            if key.startswith('level-'):
                value = outputs.level(self.output_state, key[len('level-'):])
                if value != self.level_sent.get(key) and child.send_level(value):
                    self.level_sent[key] = value

        if self.network and self.network["http_port"] and self.sdp_server is None and now >= self.next_sdp:
            try:
                self.sdp_server = sdpserver.Server("0.0.0.0", self.network["http_port"],
                                                   STATUS.with_name("network-rtp.sdp"), self.rtp_available)
                self.sdp_error = ""
            except OSError as error:
                self.sdp_error = str(error)
                log(f"rpi-audiod: SDP download unavailable: {error}")
                self.next_sdp = now + 5

    def bridge_metrics(self, key):
        """{"bridge": the last status line of a running rpi-audio-hostbridge}, or {} (zita says nothing)."""
        child, metrics = self.output_workers.get(key), self.output_metrics.get(key, {})
        if not (child and child.alive() and metrics.get("event") == "status"):
            return {}
        return {"bridge": {k: v for k, v in metrics.items() if k != "event"}}

    def rtp_available(self):
        child = self.output_workers.get(outputs.RTP)
        return bool(child and child.alive() and outputs.enabled(self.output_state, outputs.RTP, False))

    def output_status(self):
        status = []
        for identity, name, protocol, client in (("local-dac", self.sink.get("name", "pHAT DAC"), "I2S", "system"),
                                                 (outputs.USB, "USB host", "USB", "usb_host_out"),
                                                 (outputs.RTP, "Network RTP", "RTP/PCM", "network_rtp_out"),
                                                 (outputs.LINK, "Link Audio", "Link Audio", "network_link_out")):
            enabled = outputs.enabled(self.output_state, identity, identity not in (outputs.RTP, outputs.LINK))
            metrics = self.output_metrics.get(identity, {})
            if identity == "local-dac" or identity == self.sink.get("identity"):
                running = bool(self.sink) and self.jack_ready
                reason = "Local engine is waiting" if self.sink else "Select Hub or Standalone mode"
            elif identity == outputs.USB:
                child = self.output_workers.get("usb-send")
                running = bool(child and child.alive()) if self.hub else self.jack_ready and bool(self.rates[0])
                reason = "Start audio on the USB host"
            else:
                child = self.output_workers.get(identity)
                running = bool(child and child.alive())
                reason = self.network_error or metrics.get("error", "Waiting for network adapter")
            gain_child = self.output_workers.get('level-' + identity)
            gain_running = bool(gain_child and gain_child.alive())
            gain_metrics = self.output_metrics.get('level-' + identity, {})
            if running and not gain_running:
                reason = gain_metrics.get('error', 'Output volume is not ready')
            running = bool(running and gain_running)
            failed = (gain_metrics.get('error') or metrics.get("error") or
                      (self.network_error and identity in (outputs.RTP, outputs.LINK)))
            state = "disabled" if not enabled else "error" if failed else "waiting" if not running else \
                    metrics.get("state", "active")
            status.append({"identity": identity, "name": name, "protocol": protocol, "client": client,
                           "channels": self.usb_channels if identity == outputs.USB else 2,
                           "enabled": enabled, "running": running, "state": state,
                           "level": outputs.level(self.output_state, identity), "gain_running": gain_running,
                           "detail": "Disabled" if not enabled else metrics.get("detail", "") if running else reason,
                           **({"address": self.network["address"], "port": self.network["port"],
                               "sdp": str(STATUS.with_name("network-rtp.sdp")),
                               "http_port": self.network["http_port"], "http_error": self.sdp_error}
                              if identity == outputs.RTP and self.network else {}),
                           "metrics": metrics})
        return status

    def connect_midi_routes(self):
        """Brings the sequencer subscriptions between the USB devices' MIDI ports to the stored MIDI routes.
        Standalone, every subscription between two devices is ours; with a host only the ones made here are, so
        what someone connected by hand stays."""
        if not (self.standalone or self.hub or self.midi_links or self.midi_made):
            self.midi_state = {}
            return
        clients, conns = midi.parse_aconnect(run("aconnect", "-l").stdout)
        caps = midi.parse_seq_caps(read("/proc/asound/seq/clients"))
        eps = midi.endpoints(clients, self.cards)
        subs, pending = midiroute.wanted(self.midi_links, eps, caps)
        self.midi_state = {link: "" for link in self.midi_links}
        self.midi_state.update(pending)
        custom = load_slots().get("names", {})
        self.midi_ports = [{"identity": ident, "port": port, "name": presets.device_name("", custom.get(ident, {}))
                            or clients[c].name, "in": caps.get((c, port), (False, False))[0],
                            "out": caps.get((c, port), (False, False))[1]}
                           for ep, c, port in eps for ident in [midiroute.split(ep)[0]]
                           if any(caps.get((c, port), (False, False)))]
        devices = {c.number for c in clients.values() if c.card in self.cards}
        connect, disconnect = midiroute.reconcile(subs, conns, devices,
                                                  None if self.standalone or self.hub else self.midi_made)
        for src, dst in disconnect:
            if run("aconnect", "-d", "%d:%d" % src, "%d:%d" % dst).returncode == 0:
                self.midi_made.discard((src, dst))
                log("rpi-audiod: removed MIDI %d:%d -> %d:%d" % (*src, *dst))
        for src, dst in connect:
            if run("aconnect", "%d:%d" % src, "%d:%d" % dst).returncode == 0:
                self.midi_made.add((src, dst))
                log("rpi-audiod: connected MIDI %d:%d -> %d:%d" % (*src, *dst))

    def starts(self):
        """{direction: {first gadget channel: identity}}, for the control CCs."""
        out = {IN: {}, OUT: {}}
        for (i, direction), b in self.bridges.items():
            if b.start is not None:
                out[direction][b.start] = i
        return out

    def command(self, text):
        """Runs a text command from the MIDI control port (docs/MIDI.md); returns the reply."""
        try:
            cmd = midi.parse_command(text)
            if cmd.verb == "ping":
                return f"ok rpi-audio {VERSION}"
            if cmd.verb == "status":
                return midi.status_reply(self.status_data())
            return self.apply(cmd)
        except ValueError as e:
            return f"error: {e}"

    def apply(self, cmd):
        """Saves a command's change; scan_devices sees the new state and applies it."""
        try:
            save_command(cmd)
        except ValueError as e:
            return f"error: {e}"
        except OSError as e:
            return f"error: cannot save the change: {e}"
        return "ok"

    def status_data(self):
        playback_rate, capture_rate = self.rates
        custom = load_slots().get("names", {})
        labels = usb.port_labels(self.cfg.get("usb", {}).get("port_labels"))
        devices = []
        for i, dev in self.devices.items():
            mine = custom.get(i, {})
            entry = {"identity": i, "card": dev.id, "usbbus": dev.usbbus}
            if dev.port or dev.bus or dev.speed:
                entry["usb"] = self.usb_entry(dev, labels)
            name = presets.device_name(dev.profile.name if dev.profile else "", mine)
            if name:
                entry["name"] = name
            for direction in (IN, OUT):
                b = self.bridges.get((i, direction))
                if b:
                    entry[direction] = {"client": b.client, "rate": b.rate, "channels": b.channels,
                                        "start": b.start, "running": bool(b.child and b.child.alive()),
                                        "muted": i in self.muted[direction],
                                        "level": self.volumes.get((i, direction))}
                    extra = {"slots": b.size if b.size != b.channels else None,
                             "ignored": [k for k in range(1, b.channels + 1) if k not in b.kept] or None,
                             "names": presets.channel_names(dev.profile.get("names", direction) if dev.profile else (),
                                                            mine.get(direction), b.channels),
                             "fs_load": b.load or None, "blocked": b.blocked}
                    entry[direction].update({k: v for k, v in extra.items() if v})
            devices.append(entry)
        if self.standalone or self.hub:
            k = self.sink
            devices.append({"identity": k["identity"], "card": k["card"], "name": k["name"], "local": True,
                            OUT: {"channels": k["channels"], "rate": k["rate"], "running": self.jack_ready and
                                  bool(self.output_workers.get("level-local-dac") and
                                       self.output_workers["level-local-dac"].alive()),
                                  "muted": k["identity"] in self.muted[OUT], "fixed_level": True}})
        if self.hub:
            devices.append({"identity": outputs.USB, "name": "USB host", "virtual": True, "card": self.usb_card,
                            IN: {"channels": self.usb_channels, "running": bool(self.output_workers.get("usb-receive")),
                                 "rate": capture_rate, "client": "usb_host_in", **self.bridge_metrics("usb-receive")},
                            OUT: {"channels": self.usb_channels, "running": bool(self.output_workers.get("usb-send")),
                                  "rate": playback_rate, "fixed_level": True, "client": "usb_host_out",
                                  **self.bridge_metrics("usb-send")}})
        for output in self.output_status():
            if output["identity"] not in (outputs.RTP, outputs.LINK) or not (self.hub or output["enabled"]):
                continue
            devices.append({"identity": output["identity"], "name": output["name"], "virtual": True,
                            OUT: {"channels": 2, "running": output["running"], "rate": self.rate,
                                  "fixed_level": True, "muted": not output["enabled"]}})
        hosts = load_hosts()
        engine = self.sink if self.standalone or self.hub else self.cfg.get('engine', {})
        data = {"engine": {"rate": self.sink.get('rate', max(self.rates)),
                           "period": engine.get('period', 64), "periods": engine.get('periods', 3)},
                "bridge_buffer": {"period": self.cfg.get('bridge', {}).get('period', 256),
                                  "periods": self.cfg.get('bridge', {}).get('periods', 2)},
                "version": VERSION, "time": time.strftime("%Y-%m-%d %H:%M:%S"), "host_playback_rate": playback_rate,
                "host_capture_rate": capture_rate, "feeder": self.mode, "jack_ready": self.jack_ready,
                "gadget_channels": self.usb_channels if self.hub else self.channels,
                "engine_mode": "hub" if self.hub else "standalone" if self.standalone else "host",
                "host_profile": self.host_name(load_slots()), "host_profiles": sorted(hosts),
                "usb_latency": usb_latency(load_slots()),
                "host_profile_details": host_summary(self.cfg, hosts),
                "host_profile_selection": load_slots().get("host_profile"),
                "outputs": self.output_status(), "devices": devices, "usb_buses": self.usb_buses(),
                "presets": presets.summary(load_presets()),
                "midi": self.midi.status() if self.midi else None,
                **({"routes": [{**routing.entry(r), "waiting": why or None} for r, why in self.route_state.items()]}
                   if self.route_state else {}),
                **({"standalone": {k: self.sink[k] for k in ("identity", "name", "card", "channels", "rate")}}
                   if self.standalone else {}),
                **({"hub": {k: self.sink[k] for k in ("identity", "name", "card", "channels", "rate")}}
                   if self.hub else {}),
                **({"midi_routes": [{**midiroute.entry(k), "waiting": why or None}
                                    for k, why in self.midi_state.items()]} if self.midi_state else {}),
                **({"midi_ports": self.midi_ports} if self.standalone or self.hub else {})}
        session = getattr(self, 'session', None)
        data['session'] = session.snapshot() if session else {'counters': {}, 'events': []}
        observer = self.output_workers.get('observer')
        data['session']['monitor_available'] = bool(observer and observer.alive() and
                                                    self.observer_seen is not None and
                                                    time.monotonic() - self.observer_seen < 2.5)
        data['session']['monitor'] = (self.output_metrics.get('observer', {})
                                      if data['session']['monitor_available'] else {})
        scenes = load_presets()
        data['active_scene'] = presets.active_scene(load_slots(), scenes)
        midi_present = [e['endpoint'] for e in (data.get('midi') or {}).get('endpoints', [])]
        for name, info in data['host_profile_details'].items():
            profile = hosts.get(name if name != 'default' else self.cfg.get('host', {}).get('profile'), {})
            setup = profile.get('state', {})
            if 'preset' in profile:
                scene = scenes.get(str(profile['preset']), {})
                if not isinstance(scene, dict) or not isinstance(scene.get('state'), dict):
                    info['readiness'] = {'state': 'error', 'issues': [
                        {'code': 'scene', 'identity': '', 'message': f"Scene {profile['preset']} is empty"}]}
                    continue
                setup = scene['state']
            info['readiness'] = readiness.assess(setup, data, info, midi_present)
        selected = load_slots().get('host_profile') or 'default'
        data['profile_readiness'] = data['host_profile_details'].get(selected, {}).get('readiness') or {
            'state': 'error', 'issues': [{'code': 'profile', 'identity': '', 'message': 'Host profile is missing'}]}
        return data

    # --- main loop ---------------------------------------------------------------------

    def follow_host(self, now):
        """Brings the feeder to what the host's rates call for (mode A); the rates are believed when seen on two
        ticks in a row."""
        playback_rate, capture_rate = self.rates = self.host_rates()
        want = audiod.feeder(playback_rate, capture_rate)
        if want == self.pending and (want != self.target or (want and playback_rate != self.rate)):
            if want:   # the same on two ticks in a row
                log(f"rpi-audiod: host streaming at {playback_rate} Hz (capture {capture_rate}): {want}")
            else:
                log("rpi-audiod: the host stopped streaming")
            if self.rate and playback_rate != self.rate:
                self.stop_feeder()
                self.mode = None
            self.target, self.rate = want, playback_rate
        self.pending = want

    def loop(self):
        if self.standalone or self.hub:
            k = self.sink
            log(f"rpi-audiod: {'hub' if self.hub else 'standalone'} on {k['card']}, "
                f"{k['channels']} ch at {k['rate']} Hz")
            self.target, self.rate = "jack", k["rate"]
        else:
            log(f"rpi-audiod: gadget {self.card}, {self.channels} ch, sample size {self.ssize}")
        while not self.stopping:
            now = time.monotonic()
            if not (self.standalone or self.hub):
                self.follow_host(now)
            if self.target != self.mode or (self.target and not (self.jackd or self.player)):
                self.set_mode(self.target, now)
            self.check_feeder(now)
            self.check_jack_ready()
            self.sync_outputs(now)
            self.observe_system(now)
            if now >= self.next_scan:
                self.scan_devices()
                self.next_scan = now + 0.5
            if self.jack_ready:
                for b in self.bridges.values():
                    # Hub playback only needs a USB stream when a stored route feeds it.
                    # Opening an unused return wastes bus time and can disturb capture on a duplex device.
                    if self.hub and b.direction == OUT and not any(r.dst == b.dev.identity for r in self.routes):
                        b.stop()
                        b.blocked, b.next_try, b.backoff = None, 0.0, 1.0
                        continue
                    if b.child and not b.child.alive():
                        self.note('bridge_failures', f'{b.client}: bridge exited', severity='warning')
                    was_blocked = bool(b.blocked)
                    b.tick(self.cfg, now, self.bus_used(b), self.fs_budget)
                    if b.blocked and not was_blocked:
                        self.note('bandwidth_blocks', f'{b.client}: {b.blocked}', severity='warning')
                if now >= self.next_routes:
                    self.connect_routes()
                    self.next_routes = now + 1.0
            if now >= self.next_midi_routes:
                self.connect_midi_routes()
                self.next_midi_routes = now + 1.0
            if self.midi:
                if now >= self.next_midi:
                    self.midi.tick(self.cards, now)
                    self.next_midi = now + 1.0
                self.midi.drain(self)
            if now >= self.next_status:
                try:
                    write_json(STATUS, self.status_data())
                except OSError as e:
                    log(f"rpi-audiod: cannot write {STATUS}: {e}")
                self.next_status = now + 60.0 if not STATUS.parent.is_dir() else now + 2.0
            time.sleep(TICK)
        if self.restart_requested:
            self.note("mode_changes", "Audio engine mode changed")
        self.stop_feeder()
        self.session.flush(write_json)
        if self.midi:
            self.midi.stop_listener()
        log("rpi-audiod: stopped")


def cmd_status(_):
    try:
        s = json.loads(STATUS.read_text())
    except (OSError, ValueError):
        sys.exit("rpi-audiod: no status; is rpi-audiod.service running?")
    print(f"rpi-audiod {s.get('version', '?')}")
    alone = s.get("standalone") or s.get("hub")
    if alone:
        print(f"{s['time']}  {s.get('engine_mode', 'standalone')}: {alone['card']}, "
              f"{alone['channels']} ch at {alone['rate']} Hz;"
              f" jackd {'up' if s['jack_ready'] else 'not up'}")
    else:
        print(f"{s['time']}  host: playback {s['host_playback_rate']} Hz, capture {s['host_capture_rate']} Hz;"
              f" feeder: {s['feeder']}{' (jack up)' if s['jack_ready'] else ''}")
    for d in s["devices"]:
        print(f"  {d.get('card', 'virtual'):12} {d['identity']}" + (f"  {d['name']}" if d.get("name") else ""))
        if d.get("virtual"):
            for side in (IN, OUT):
                if side in d:
                    b = d[side]
                    print(f"    {side}: {b['channels']} ch, {'running' if b['running'] else 'waiting'}")
                    m = b.get("bridge")
                    if m:   # rpi-audio-hostbridge: its buffer in gadget frames, as of each JACK cycle's start
                        print(f"      native bridge {m.get('state')}: buffer {m.get('fill_min')}/{m.get('fill_avg')}/"
                              f"{m.get('fill_max')} frames (min/avg/max, margin {m.get('margin')}), "
                              f"{m.get('ppm')} ppm, {m.get('resyncs')} resyncs, late up to {m.get('late_max_us')} us")
            continue
        if d.get("local"):
            b = d[OUT]
            print(f"    {'system':16} {b['channels']} ch {b['rate']} Hz  local output"
                  f"  {'running' if b['running'] else 'not running'}{', muted' if b.get('muted') else ''}")
            continue
        for direction, label in ((IN, "capture" if alone else "to host IN"),
                                 (OUT, "playback" if alone else "from host OUT")):
            b = d.get(direction)
            if b:
                size = b.get("slots", b["channels"])
                where = ("" if alone else f"{b['start']}-{b['start'] + size - 1}" if b["start"] else "parked")
                extra = ", muted" if b.get("muted") else ""
                if b.get("names"):
                    extra += f", channels {' '.join(n or '-' for n in b['names'])}"
                if b.get("ignored"):
                    extra += ", ignoring " + ",".join(map(str, b["ignored"]))
                if b.get("level") is not None:
                    extra += f", level {b['level']}%"
                print(f"    {b['client']:16} {b['channels']} ch {b['rate']} Hz  {label} {where}".rstrip()
                      + f"  {'running' if b['running'] else 'not running'}{extra}")
                if b.get("blocked"):
                    print(f"      waiting: {b['blocked']}")
    if s.get("presets"):
        print("  presets: " + ", ".join(f"{p['slot']} {p['name']} ({p['saved']})" for p in s["presets"]))
    for output in s.get("outputs", []):
        print(f"  output {output['name']}: {output['state']}, level {output.get('level', 100)}% "
              f"({output['protocol']}) {output['detail']}")
    profile = s.get('profile_readiness')
    if profile:
        print(f"  profile {s.get('host_profile_selection') or 'default'}: {profile['state']}")
        for issue in profile.get('issues', []):
            print('    ' + issue['message'])
    session = s.get('session', {})
    if session.get('started'):
        counts = session.get('counters', {})
        print(f"  session since {session['started']}: {counts.get('xruns', 0)} xruns, "
              f"{counts.get('network_dropped_frames', 0)} TX dropped frames")
        for event in session.get('events', [])[-5:]:
            print(f"    {event['time']} {event['detail']} (x{event['count']})")
    m = s.get("midi")
    if m:
        state = ("on client %s" % m["client"]) if m["client"] is not None else "not found"
        print(f"  MIDI: {m['ports']} gadget ports ({m['card']} {state}), control on port {m['control_port']}"
              f"{', host connected' if m['host_connected'] else ''}{'' if m['listening'] else ', not listening'}")
        for e in m["endpoints"]:
            print(f"    {e['endpoint']:40} {'port %d' % e['port'] if e['port'] else 'parked'}")


def cmd_doctor(_):
    """Checks what usually goes wrong, one line each. Exit status 1 if something is broken."""
    bad = 0

    def line(level, what, detail):
        nonlocal bad
        bad += level == "FAIL"
        print(f"{level:4}  {what:10} {detail}")

    line("ok", "version", VERSION)
    standalone = load_config()["engine"].get("mode", "host") == "standalone"
    udcs = sorted(glob.glob("/sys/class/udc/*"))
    if standalone:
        line("info", "udc", "not used: [engine] mode is standalone (no host)")
        udcs = []
    elif not udcs:
        line("FAIL", "udc", "no USB device controller: is dtoverlay=dwc2,dr_mode=peripheral in config.txt?"
             " (then reboot)")
    for u in udcs:
        state = read(f"{u}/state").strip() or "?"
        hint = "" if state == "configured" else " (is the USB-C connected to a host?)"
        line("ok" if state == "configured" else "warn", "udc", f"{os.path.basename(u)}: {state}{hint}")
    for unit in ("rpi-audio-gadget", "rpi-audiod", "rpi-audio-cpu"):
        active = run("systemctl", "is-active", f"{unit}.service").stdout.strip() or "?"
        enabled = run("systemctl", "is-enabled", f"{unit}.service").stdout.strip() or "?"
        level = ("ok" if active == "active" else "warn" if unit == "rpi-audio-cpu"
                 or standalone and unit == "rpi-audio-gadget" else "FAIL")
        line(level, "service", f"{unit}: {active}, {enabled}")
    try:
        s = json.loads(STATUS.read_text())
        age = time.time() - STATUS.stat().st_mtime
        local = s.get("standalone") or s.get("hub")
        what = (f"{s.get('engine_mode', 'standalone')} on {local['card']}; "
                f"jackd {'up' if s['jack_ready'] else 'not up'}" if local else
                f"host playback {s['host_playback_rate']} Hz,"
                f" capture {s['host_capture_rate']} Hz; feeder {s['feeder']}")
        line("ok" if age < 10 else "FAIL", "status", f"written {age:.0f} s ago; {what}")
        for output in s.get("outputs", []):
            if output["enabled"] and output["state"] == "error":
                line("warn", "output", f"{output['name']}: {output['detail']}")
        for d in s["devices"]:
            if d.get("virtual"):
                continue
            for direction in (IN, OUT):
                b = d.get(direction) or {}
                if b.get("blocked"):
                    line("warn", "device", f"{d['identity']} {direction}: {b['blocked']}")
                elif b and s["feeder"] == "jack" and not b["running"]:
                    line("warn", "device", f"{d['identity']} {direction}: bridge not running")
    except (OSError, ValueError, KeyError) as e:
        line("FAIL", "status", f"cannot read {STATUS}: {e}")
    govs = {read(f).strip() or "?" for f in glob.glob(f"{CPUFREQ}/policy*/scaling_governor")}
    if govs:
        line("ok" if govs == {"performance"} else "warn", "cpu", "governor " + ", ".join(sorted(govs)))
    throttled = run("vcgencmd", "get_throttled").stdout.strip()
    if throttled.startswith("throttled="):
        fine = throttled == "throttled=0x0"
        line("ok" if fine else "warn", "power",
             throttled + ("" if fine else " (under-voltage or throttling since boot: check the power supply)"))
    elif throttled:
        line("info", "power", "vcgencmd cannot read it as this user (run doctor with sudo)")
    cmdline = read("/proc/cmdline") or ""
    line("ok" if "threadirqs" in cmdline.split() else "info", "boot",
         "threadirqs " + ("on" if "threadirqs" in cmdline.split() else "off (install.sh --tune-boot)"))
    hogs = [p for p in ("pipewire", "pulseaudio") if run("pgrep", "-x", p).stdout.strip()]
    if hogs:
        line("warn", "audio", "running: " + ", ".join(hogs) + " (it may grab the gadget)")
    else:
        line("ok", "audio", "no PipeWire or PulseAudio")
    pending = sorted(glob.glob(str(CONFIG.parent / "*.new")))
    if pending:
        line("warn", "config", "newer settings waiting: " + " ".join(pending) + " (diff, then move them in place)")
    sys.exit(1 if bad else 0)


def cmd_change(text):
    """assign, mute, volume, name and preset from the command line: the same commands, and the
    same checks, as on the MIDI control port (docs/MIDI.md)."""
    try:
        command = midi.parse_command(text)
        save_command(command)
    except ValueError as e:
        sys.exit(f"rpi-audiod: {e}")
    except OSError as e:
        sys.exit(f"rpi-audiod: cannot save: {e} (use an account in the audio group)")
    if command.verb == 'host' and command.arg('action') in ('save', 'preset'):
        name = command.arg('name')
        print(f'rpi-audiod: profile {name} saved; apply it with: rpi-audiod host {name}')
    elif command.verb == 'host' and command.arg('action') in ('rename', 'delete'):
        print('rpi-audiod: host profile updated')
    elif command.verb == 'usb':
        print('rpi-audiod: saved; the USB gadget applies it at the next restart of the Pi')
    else:
        print('rpi-audiod: saved; the service applies it within a second or two')


def main():
    p = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    p.add_argument("--version", action="version", version=f"rpi-audiod {VERSION}")
    sub = p.add_subparsers(dest="cmd")
    sub.add_parser("run")
    sub.add_parser("status")
    sub.add_parser("doctor")
    e = sub.add_parser("engine")
    e.add_argument("mode", choices=("host", "standalone", "hub"))
    h = sub.add_parser("host", help="host NAME|default, host save NAME [in=K,K] [out=K,K], host delete NAME")
    h.add_argument("words", nargs="+", metavar="WORD", help="see docs/MIDI.md")
    o = sub.add_parser("output")
    o.add_argument("identity", choices=outputs.IDS)
    o.add_argument("value", choices=("on", "off", "level"))
    o.add_argument("percent", nargs="?", type=int)
    a = sub.add_parser("assign")
    a.add_argument("identity")
    a.add_argument("--in", dest="in_", type=int, help="first gadget IN channel (Pi -> host)")
    a.add_argument("--out", type=int, help="first gadget OUT channel (host -> Pi)")
    a.add_argument("--midi", type=int, help="gadget MIDI port, for IDENTITY/P (P defaults to 0)")
    for verb, last in (("mute", "on|off"), ("volume", "PERCENT")):
        v = sub.add_parser(verb)
        v.add_argument("identity")
        v.add_argument("direction", help="in|out")
        v.add_argument("value", metavar=last)
    n = sub.add_parser("name")
    n.add_argument("identity")
    n.add_argument("words", nargs="*", metavar="WORD", help="channel form, then the name; empty clears it")
    for verb in ("route", "unroute"):
        v = sub.add_parser(verb)
        v.add_argument("src", help="identity of the device whose capture feeds the route")
        v.add_argument("dst", help="identity of the device whose playback receives it")
        v.add_argument("--src", dest="src_pair", type=int, help="stereo pair of the source, from 1")
        v.add_argument("--dst", dest="dst_pair", type=int, help="stereo pair of the destination, from 1")
    c = sub.add_parser("cmd")
    c.add_argument("words", nargs="+", metavar="TEXT", help="a command of docs/MIDI.md, e.g. mute ID in on")
    for verb in ("midiroute", "midiunroute"):
        v = sub.add_parser(verb)
        v.add_argument("src", help="IDENTITY or IDENTITY/PORT of the MIDI port that sends")
        v.add_argument("dst", help="IDENTITY or IDENTITY/PORT of the MIDI port that receives")
    r = sub.add_parser("preset")
    r.add_argument("action", choices=("save", "load", "clear"))
    r.add_argument("slot", help="1..8")
    r.add_argument("words", nargs="*", metavar="TEXT", help="the preset's name, for save")
    args = p.parse_args()
    if args.cmd == "status":
        return cmd_status(args)
    if args.cmd == "doctor":
        return cmd_doctor(args)
    if args.cmd == "engine":
        return cmd_change(f"engine {args.mode}")
    if args.cmd == "host":
        return cmd_change(" ".join(["host", *args.words]))
    if args.cmd == "output":
        suffix = "" if args.percent is None else f" {args.percent}"
        return cmd_change(f"output {args.identity} {args.value}{suffix}")
    if args.cmd == "assign":
        keys = [f"{k}={v}" for k, v in (("in", args.in_), ("out", args.out), ("midi", args.midi)) if v is not None]
        return cmd_change(" ".join(["assign", args.identity, *keys]))
    if args.cmd in ("mute", "volume"):
        return cmd_change(" ".join([args.cmd, args.identity, args.direction, args.value]))
    if args.cmd in ("route", "unroute"):
        keys = [f"{k}={v}" for k, v in (("src", args.src_pair), ("dst", args.dst_pair)) if v is not None]
        return cmd_change(" ".join([args.cmd, args.src, args.dst, *keys]))
    if args.cmd in ("midiroute", "midiunroute"):
        return cmd_change(f"{args.cmd} {args.src} {args.dst}")
    if args.cmd == "cmd":
        return cmd_change(" ".join(args.words))
    if args.cmd == "name":
        return cmd_change(" ".join(["name", args.identity, *args.words]))
    if args.cmd == "preset":
        return cmd_change(" ".join(["preset", args.action, args.slot, *args.words]))
    stopping = False
    daemon = None

    def stop(*_):
        nonlocal stopping
        stopping = True
        if daemon:
            daemon.stopping = True

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    while not stopping:
        daemon = Daemon(load_config())
        daemon.loop()
        if not daemon.restart_requested:
            break


