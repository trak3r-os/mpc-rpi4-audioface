[Unit]
Description=rpi-audio: feed the gadget and bridge USB audio devices to it
# Replaces rpi-audio-keepalive: it also plays into the gadget whenever the host streams.
After=rpi-audio-gadget.service sound.target
BindsTo=rpi-audio-gadget.service
Conflicts=rpi-audio-keepalive.service

[Service]
# READY=1 once the settings are loaded, then WATCHDOG=1 from every pass of the main loop (sdnotify.py).
# A pass normally takes 0.1 s. The slowest normal ones take seconds: each external command it runs times
# out after 2 s, and a mode change stops every child, each with 1 s to exit before it is killed (MIDI
# replies go out from a thread of their own). 30 s leaves room for about ten seconds of that, three
# times over: only a hang (a lock, a child stuck in the kernel) trips it, and then systemd aborts the
# service and Restart= brings it back. The gadget unit has no watchdog and no Restart=, on purpose.
Type=notify
NotifyAccess=main
WatchdogSec=30s
EnvironmentFile=-/etc/rpi-audio/gadget.env
ExecStart=/usr/local/lib/rpi-audio/rpi-audiod
Restart=always
RestartSec=1
User=rpi-audio
Group=audio
# The service and local audio-group users can edit their saved profiles without root.
StateDirectory=rpi-audio
StateDirectoryMode=2775
# RAM-only incident history survives service restarts until the next boot.
RuntimeDirectory=rpi-audio
RuntimeDirectoryPreserve=yes
# jackd and the zita bridges run realtime and lock their memory.
LimitRTPRIO=95
LimitMEMLOCK=infinity
# rpi-audiod stops the bridges, then jackd, in that order.
KillMode=mixed
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
