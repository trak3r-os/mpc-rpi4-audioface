diff --git a/tests/usb_iso_prearm_test.cpp b/tests/usb_iso_prearm_test.cpp
new file mode 100644
index 0000000..a39a2c5
--- /dev/null
+++ b/tests/usb_iso_prearm_test.cpp
@@ -0,0 +1,81 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include <doctest/doctest.h>
+#include "usb_rig.h"
+#include "usb_test_util.h"
+#include <o3os/usb/iso_audio.h>
+#include <initializer_list>
+#include <cstring>
+
+using namespace o3os::usb;
+using namespace usb_rig;
+
+TEST_CASE("iso prearm: two frame polls survive a delayed interrupt then recover") {
+  for (Profile profile : {Profile::P2, Profile::P4, Profile::P6, Profile::P8, Profile::P10, Profile::P11}) {
+    Config cfg;
+    cfg.mode = Mode::Audio;
+    cfg.profile = profile;
+    cfg.usb_return = false;
+    Rig rig(cfg);
+    StemRing stems;
+    ReturnRing returns;
+    ReturnReader reader(returns, rig.audio);
+    IsoAudio iso(stems, returns, reader, rig.audio);
+    rig.dev.bind_audio(&iso);
+    rig.hw.set_sof_period(nominal_sof_cycles(Speed::Full));
+    USB_REQUIRE(rig.enumerate());
+    std::uint8_t setup[8];
+    usb_fake::make_setup(setup, 0x01, 0x0B, 1, layout::kIfAudioIn, 0);
+    USB_REQUIRE(rig.host.control_none(setup).ok);
+    alignas(4) std::int16_t pool[3][kMaxChannels][kStemBlockFrames] = {};
+    const std::uint32_t channels = profile_channels(profile);
+    for (std::uint32_t b = 0; b < 3u; ++b) {
+      StemBlock block{};
+      for (std::uint32_t c = 0; c < channels; ++c) {
+        for (std::uint32_t i = 0; i < kStemBlockFrames; ++i) {
+          pool[b][c][i] = static_cast<std::int16_t>(1u + (b * kStemBlockFrames + i) * 11u + c);
+        }
+        block.ch[c] = pool[b][c];
+      }
+      stems.write(&block, 1);
+    }
+    std::uint8_t first[1024], second[1024];
+    std::uint32_t len = 0;
+    bool data1 = false;
+    // Consume the two initial silent packets; their refills now contain known stem data.
+    for (unsigned i = 0; i < 2u; ++i) {
+      rig.hw.sof();
+      USB_REQUIRE(rig.hw.in(4, first, sizeof first, len, data1) == Reply::Ack);
+    }
+    std::uint32_t next_frame = 0;
+    const auto check_samples = [&](const std::uint8_t* packet, std::uint32_t bytes) {
+      USB_REQUIRE(bytes > 0u);
+      USB_REQUIRE(bytes % (channels * 2u) == 0u);
+      for (std::uint32_t frame = 0; frame < bytes / (channels * 2u); ++frame) {
+        for (std::uint32_t c = 0; c < channels; ++c) {
+          std::int16_t actual = 0;
+          std::memcpy(&actual, packet + (frame * channels + c) * 2u, sizeof actual);
+          CHECK(actual == static_cast<std::int16_t>(1u + (next_frame + frame) * 11u + c));
+        }
+      }
+      next_frame += bytes / (channels * 2u);
+    };
+    rig.hw.set_auto_isr(false);
+    // First transfer completes in hardware. Its completion interrupt is delayed.
+    rig.hw.sof();
+    CHECK(rig.hw.in(4, first, sizeof first, len, data1) == Reply::Ack);
+    check_samples(first, len);
+    // The host polls in the next frame before the IRQ has serviced the first completion.
+    rig.hw.sof();
+    CHECK(rig.hw.in(4, second, sizeof second, len, data1) == Reply::Ack);
+    check_samples(second, len);
+    // After servicing the queued completions both descriptors are refilled in order.
+    rig.hw.interrupt();
+    rig.hw.set_auto_isr(true);
+    rig.hw.sof();
+    CHECK(rig.hw.in(4, first, sizeof first, len, data1) == Reply::Ack);
+    check_samples(first, len);
+    CHECK(rig.dev.counters().pingpong_resyncs == 0u);
+    // The two descriptors must point to distinct storage.
+    CHECK(rig.bdt.entry[bdt_index(4, true, false)].addr != rig.bdt.entry[bdt_index(4, true, true)].addr);
+  }
+}
